<Window x:Class="SistemaRocaMaya.Views.CashSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caja · Roca Maya" Width="430" Height="610"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource RocaMayaCreamBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="{StaticResource RocaMayaBlueSecondaryBrush}" Padding="20,0">
            <TextBlock Text="{Binding TitleText}" FontSize="17" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
        </Border>
        <Grid Grid.Row="1" Margin="18,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#D8E3EA" BorderThickness="1" Padding="12,9"
                    Visibility="{Binding ExpectedPanelVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="EFECTIVO ESPERADO" FontSize="9" FontWeight="Bold" Foreground="#526A7A" />
                        <TextBlock Text="Apertura + ventas al contado" Margin="0,3,0,0" FontSize="10" Foreground="#526A7A" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ExpectedAmountText}" VerticalAlignment="Center" FontSize="18"
                               FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,10,0,8">
                <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Background="{StaticResource RocaMayaCreamBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="75" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions>
                    <TextBlock Text="DENOMINACIÓN" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="CANTIDAD" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                    <TextBlock Grid.Column="2" Text="SUBTOTAL" Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="9" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                </Grid>
                <Border Grid.Row="1" Background="White" BorderBrush="#D8E3EA" BorderThickness="1">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="39" Margin="10,0" >
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="75" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DenominationText}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="29" Padding="4,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SubtotalText}" Margin="0,0,2,0" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" FontSize="11" Foreground="#526A7A" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource RocaMayaBlackPrimaryBrush}" Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="TOTAL CONTADO" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="White" />
                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" />
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="White" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Content="Cancelar" IsCancel="True" Click="Cancel_Click" Background="White"
                        BorderBrush="#C8DCE8" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                <Button Grid.Column="1" Content="{Binding ActionLabel}" Click="Confirm_Click"
                        Background="{StaticResource RocaMayaBlackPrimaryBrush}" BorderThickness="0" Foreground="White" />
            </Grid>
        </Border>
    </Grid>
</Window>
