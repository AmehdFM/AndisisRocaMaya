<Window x:Class="SistemaRocaMaya.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo producto · Roca Maya" Width="440" Height="570"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource RocaMayaSurfaceBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBluePrimaryBrush}" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource AppButton}" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
            <DockPanel>
                <Image DockPanel.Dock="Right" Source="{StaticResource ReportWordmark}" Width="86" Height="36" Stretch="Uniform" Margin="12,0,0,0" AutomationProperties.Name="Consul Farma Roca Maya" />
                <TextBlock Text="Nuevo producto" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,16">
                <TextBlock Text="Nombre" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" />
                <TextBlock x:Name="IdPreviewText" FontSize="10" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}"
                           Margin="0,8,0,0" />
                <TextBlock Text="Precio de venta" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,10,0,4" />
                <TextBox x:Name="PriceBox" />
                <TextBlock Text="Cantidad inicial (opcional)" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,10,0,4" />
                <TextBox x:Name="QuantityBox" Text="0" />
                <TextBlock Text="Fecha de ingreso" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,10,0,4" />
                <DatePicker x:Name="PurchaseDatePicker" />
                <TextBlock Text="Fecha de vencimiento (opcional)" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,10,0,4" />
                <DatePicker x:Name="ExpirationDatePicker" />
                <TextBlock x:Name="ValidationText" Margin="0,9,0,0" FontSize="10" Foreground="{StaticResource RocaMayaDangerBrush}"
                           Text="Revisa el nombre, precio y cantidad." Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AppButton}" Content="Cancelar" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource AppPrimaryButton}" Content="Crear producto" Click="Create_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
