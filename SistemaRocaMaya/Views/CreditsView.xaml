<UserControl x:Class="SistemaRocaMaya.Views.CreditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid Background="#F3F6F8" Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Crédito" FontSize="26" FontWeight="Bold"
                   Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" Margin="0,0,0,16" />

        <Grid Grid.Row="1">
            <Grid x:Name="CustomerListPanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustomerSelected}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="10,0"
                             VerticalContentAlignment="Center" Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                             ToolTip="Buscar por nombre, teléfono o identidad/RTN" />
                    <TextBlock Text="Buscar por nombre, teléfono o identidad/RTN" Margin="12,0" VerticalAlignment="Center"
                               Foreground="#7A8D99" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="1" Margin="0,12,0,0" Background="{StaticResource RocaMayaCreamBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                    <TextBlock Text="CLIENTE" Margin="14,0" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="CONTACTO" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                    <TextBlock Grid.Column="2" Text="ACTIVIDAD" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                    <TextBlock Grid.Column="3" Text="SALDO PENDIENTE" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                </Grid>
                <ListBox Grid.Row="2" Margin="0,0,0,0" ItemsSource="{Binding CustomersWithCredit}" SelectedItem="{Binding SelectedCustomer}"
                         Background="White" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="White" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EAF3F8" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DCEEF7" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,12" BorderBrush="#D8E3EA" BorderThickness="0,0,0,1"
                                    Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}">
                                <Grid MinHeight="52">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                        <TextBlock Text="{Binding TypeLabel}" Margin="0,3,0,0" FontSize="10" Foreground="#526A7A" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                        <TextBlock Text="{Binding TaxOrIdentity}" Margin="0,3,0,0" FontSize="10" Foreground="#526A7A" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding CreditHistory.Count, StringFormat='{}{0} movimientos'}"
                                               VerticalAlignment="Center" FontSize="11" Foreground="#526A7A" />
                                    <TextBlock Grid.Column="3" Text="{Binding BalanceText}" Margin="0,0,14,0" VerticalAlignment="Center"
                                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="›" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontSize="22" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid x:Name="CustomerCreditPanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustomerSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Content="← Clientes" Command="{Binding ShowCustomerListCommand}" Height="36" Padding="12,0"
                            Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                            Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" Cursor="Hand" />
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCustomer.Name}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                        <TextBlock Text="{Binding SelectedCustomer.Phone}" Margin="0,3,0,0" FontSize="11" Foreground="#526A7A" />
                        <TextBlock Text="{Binding SelectedCustomer.TaxOrIdentity}" Margin="0,2,0,0" FontSize="11" Foreground="#526A7A" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="SALDO PENDIENTE" FontSize="9" FontWeight="Bold" Foreground="#526A7A" />
                        <TextBlock Text="{Binding SelectedCustomerBalanceText}" Margin="0,3,0,0" FontSize="22"
                                   FontWeight="Bold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11" Foreground="#526A7A" />
                    <Button Grid.Column="1" Content="＋  Registrar abono" Click="RecordPayment_Click"
                            IsEnabled="{Binding HasSelectedCustomer}" Height="40" Padding="16,0"
                            Background="{StaticResource RocaMayaBlueSecondaryBrush}" BorderThickness="0"
                            Foreground="White" FontSize="12" FontWeight="SemiBold" Cursor="Hand" />
                </Grid>
                <TextBox Grid.Row="2" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="34" Padding="10,0" Margin="0,0,0,8" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                         ToolTip="Buscar en movimientos por descripción, tipo o fecha" />
                <Border Grid.Row="3" Background="White" BorderBrush="#D8E3EA" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{StaticResource RocaMayaCreamBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="FECHA" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="MOVIMIENTO" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Text="MONTO" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                <TextBlock Grid.Column="3" Text="SALDO" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedCustomerHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="42" Margin="12,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM/yy}'}" VerticalAlignment="Center" FontSize="10" Foreground="#526A7A" />
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                                <TextBlock Text="{Binding Description}" FontSize="9" Foreground="#526A7A" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding AmountText}" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding BalanceText}" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
