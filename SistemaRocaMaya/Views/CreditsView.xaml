<UserControl x:Class="SistemaRocaMaya.Views.CreditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid Background="#F3F6F8" Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Crédito" FontSize="26" FontWeight="Bold"
                   Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" Margin="0,0,0,16" />

        <Grid Grid.Row="1">
            <Grid x:Name="CustomerListPanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustomerSelected}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="10,0"
                         VerticalContentAlignment="Center" Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                         ToolTip="Buscar cliente" />
                <Border Grid.Row="1" Margin="0,10,0,0" Background="White" BorderBrush="#D8E3EA" BorderThickness="1">
                    <ListBox ItemsSource="{Binding CustomersWithCredit}" SelectedItem="{Binding SelectedCustomer}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,12" BorderBrush="#E5E9EC" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                            <TextBlock Text="{Binding TypeLabel}" Margin="0,3,0,0" FontSize="10" Foreground="#526A7A" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding BalanceText}" VerticalAlignment="Center"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Grid x:Name="CustomerCreditPanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustomerSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Content="← Clientes" Command="{Binding ShowCustomerListCommand}" Height="36" Padding="12,0"
                            Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                            Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" Cursor="Hand" />
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCustomer.Name}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                        <TextBlock Text="{Binding SelectedCustomer.Phone}" Margin="0,3,0,0" FontSize="11" Foreground="#526A7A" />
                        <TextBlock Text="{Binding SelectedCustomer.TaxOrIdentity}" Margin="0,2,0,0" FontSize="11" Foreground="#526A7A" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="SALDO PENDIENTE" FontSize="9" FontWeight="Bold" Foreground="#526A7A" />
                        <TextBlock Text="{Binding SelectedCustomerBalanceText}" Margin="0,3,0,0" FontSize="22"
                                   FontWeight="Bold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Margin="0,0,0,12" Padding="12" Background="#EAF3F8" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Registrar abono" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                            <TextBlock Text="{Binding StatusMessage}" Margin="0,3,0,0" FontSize="10" Foreground="#526A7A" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" Padding="8,0" VerticalContentAlignment="Center" Background="White"
                                 BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" ToolTip="Monto del abono" />
                        <Button Grid.Column="2" Content="Aplicar" Command="{Binding RecordPaymentCommand}"
                                IsEnabled="{Binding HasSelectedCustomer}" Height="36" Margin="8,0,0,0" Padding="12,0"
                                Background="{StaticResource RocaMayaBlackPrimaryBrush}" BorderThickness="0" Foreground="White" FontSize="11" />
                    </Grid>
                </Border>
                <TextBox Grid.Row="2" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="34" Padding="10,0" Margin="0,0,0,8" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                         ToolTip="Buscar en movimientos por descripción, tipo o fecha" />
                <Border Grid.Row="3" Background="White" BorderBrush="#D8E3EA" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{StaticResource RocaMayaCreamBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="FECHA" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="MOVIMIENTO" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Text="MONTO" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                <TextBlock Grid.Column="3" Text="SALDO" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedCustomerHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="42" Margin="12,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM/yy}'}" VerticalAlignment="Center" FontSize="10" Foreground="#526A7A" />
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                                <TextBlock Text="{Binding Description}" FontSize="9" Foreground="#526A7A" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding AmountText}" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding BalanceText}" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
