<Window x:Class="SistemaRocaMaya.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaRocaMaya.Views"
        mc:Ignorable="d"
        Title="Sistema Roca Maya"
        Height="500"
        Width="800"
        MinHeight="480"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#0B1E38">
    <Window.Resources>
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#172B45" />
            <Setter Property="CaretBrush" Value="#1478D4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder"
                                Background="#F7FAFE"
                                BorderBrush="#DCE7F3"
                                BorderThickness="1"
                                CornerRadius="11">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="13,0"
                                              VerticalAlignment="Center" />
                                <TextBlock Margin="14,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="#637A94"
                                           Text="{TemplateBinding Tag}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#2C8CE0" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#172B45" />
            <Setter Property="CaretBrush" Value="#1478D4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="FieldBorder"
                                Background="#F7FAFE"
                                BorderBrush="#DCE7F3"
                                BorderThickness="1"
                                CornerRadius="11">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="13,0"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#2C8CE0" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#1478D4" />
            <Setter Property="BorderBrush" Value="#1478D4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <Grid Margin="18,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <Path Width="11"
                                      Height="11"
                                      Margin="0,0,2,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Data="M1,5.5 L9,5.5 M5.5,2 L9,5.5 L5.5,9"
                                      Stroke="White"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#0C68BD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#095BA8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#F1BD59" />
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D2543" Offset="0" />
                <GradientStop Color="#124B7D" Offset="0.57" />
                <GradientStop Color="#187EB8" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Canvas IsHitTestVisible="False" Opacity="0.19">
            <Ellipse Width="330" Height="330" Canvas.Left="-135" Canvas.Top="-177"
                     Stroke="#94D9F5" StrokeThickness="1.2" />
            <Ellipse Width="250" Height="250" Canvas.Left="-95" Canvas.Top="-137"
                     Stroke="#94D9F5" StrokeThickness="1.2" />
            <Ellipse Width="420" Height="420" Canvas.Right="-172" Canvas.Bottom="-252"
                     Stroke="#A8E7FA" StrokeThickness="1.2" />
            <Ellipse Width="310" Height="310" Canvas.Right="-117" Canvas.Bottom="-197"
                     Stroke="#A8E7FA" StrokeThickness="1.2" />
        </Canvas>

        <Border Width="430"
                Margin="24,16"
                Padding="34,16,34,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="22">
            <Border.Effect>
                <DropShadowEffect Color="#07182C"
                                  Opacity="0.28"
                                  BlurRadius="28"
                                  ShadowDepth="12" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="52" Height="64" CornerRadius="12" Background="#1478D4">
                        <Image Width="42"
                               Height="60"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               Source="{StaticResource RocaMayaLogo}"
                               AutomationProperties.Name="Logo de Consulfarma Rocamaya" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ROCA MAYA"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#183453" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="SISTEMA DE GESTIÓN"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#6C8098" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Margin="0,12,0,0"
                           Text="Bienvenido"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#112A46" />
                <TextBlock Grid.Row="2"
                           Margin="0,2,0,12"
                           Text="Ingresa tus datos para continuar"
                           FontSize="13"
                           Foreground="#667B94" />

                <TextBlock Grid.Row="3"
                           Margin="0,0,0,5"
                           Text="Usuario"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#304963" />
                <TextBox Grid.Row="4"
                         Style="{StaticResource LoginTextBoxStyle}"
                         Tag="Tu nombre de usuario"
                         AutomationProperties.Name="Usuario" />

                <TextBlock Grid.Row="5"
                           Margin="0,10,0,5"
                           Text="Contraseña"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#304963" />
                <PasswordBox Grid.Row="6"
                             Style="{StaticResource LoginPasswordBoxStyle}"
                             AutomationProperties.Name="Contraseña" />

                <StackPanel Grid.Row="7" Margin="0,12,0,0">
                    <Button Style="{StaticResource LoginButtonStyle}"
                            Content="Iniciar sesión"
                            Click="SignIn_Click" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Text="Acceso exclusivo para personal autorizado"
                               FontSize="11"
                               Foreground="#667B94" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
