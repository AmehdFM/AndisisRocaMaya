<Window x:Class="SistemaRocaMaya.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaRocaMaya.Views"
        mc:Ignorable="d"
        Title="Sistema Roca Maya"
        Height="500"
        Width="800"
        MinHeight="480"
        MinWidth="700"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource RocaMayaBlackPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder"
                                Background="{StaticResource RocaMayaCreamBrush}"
                                BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="13,0"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource RocaMayaBluePrimaryBrush}" />
                                <Setter TargetName="FieldBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="FieldBorder"
                                Background="{StaticResource RocaMayaCreamBrush}"
                                BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="13,0"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource RocaMayaBluePrimaryBrush}" />
                                <Setter TargetName="FieldBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource RocaMayaCreamBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource RocaMayaBlackPureBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource RocaMayaCreamBrush}" />
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource RocaMayaBlackPrimary}" Offset="0" />
                <GradientStop Color="{StaticResource RocaMayaBlueSecondary}" Offset="0.58" />
                <GradientStop Color="{StaticResource RocaMayaBluePrimary}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Image Grid.Column="0"
               MaxWidth="380"
               MaxHeight="840"
               Margin="0,0,20,0"
               HorizontalAlignment="Right"
               VerticalAlignment="Center"
               Source="{StaticResource RocaMayaLogo}"
               Stretch="Uniform"
               Opacity="0.2"
               IsHitTestVisible="False" />

        <Border Grid.Column="1"
                Width="430"
                Margin="24,16"
                Padding="34,16,34,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource RocaMayaCreamBrush}"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect Color="{StaticResource RocaMayaBlackPure}"
                                  Opacity="0.28"
                                  BlurRadius="28"
                                  ShadowDepth="12" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,18"
                           Text="Roca Maya"
                           FontSize="25"
                           FontWeight="Normal"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />

                <TextBlock Grid.Row="1"
                           Margin="0,0,0,5"
                           Text="Usuario"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                <TextBox Grid.Row="2"
                         x:Name="UsernameBox"
                         Style="{StaticResource LoginTextBoxStyle}"
                         AutomationProperties.Name="Usuario" />

                <TextBlock Grid.Row="3"
                           Margin="0,15,0,5"
                           Text="Contraseña"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                <PasswordBox Grid.Row="4"
                             x:Name="PasswordInput"
                             Style="{StaticResource LoginPasswordBoxStyle}"
                             AutomationProperties.Name="Contraseña" />

                <Button Grid.Row="5"
                        Margin="0,20,0,0"
                        Style="{StaticResource LoginButtonStyle}"
                        Content="Iniciar sesión"
                        Click="SignIn_Click" />
                <TextBlock Grid.Row="6" Margin="0,8,0,0" TextAlignment="Center" FontSize="9"
                           Foreground="#526A7A" Text="Demo: Administrador / Admin1234 · Empleado / Empleado1234" />
            </Grid>
        </Border>
    </Grid>
</Window>
