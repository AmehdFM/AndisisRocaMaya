<UserControl x:Class="SistemaRocaMaya.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="PurchaseReportNumericCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBluePrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource RocaMayaSurfaceBrush}" Margin="28,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Compras" FontSize="26" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="＋  Crear producto" Click="CreateProduct_Click"
                    Height="40" Padding="14,0" Background="White" BorderBrush="{StaticResource RocaMayaBlueSecondaryBrush}"
                    Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" FontWeight="SemiBold" Cursor="Hand" />
        </Grid>
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource RocaMayaBorderBrush}">
          <TabItem Header="Registrar compra">
          <Grid Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,18,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Margin="0,0,0,10" Background="{StaticResource RocaMayaBlueSurfaceBrush}"
                        BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="10,7,10,7">
                            <TextBlock Text="Proveedor" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                      DisplayMemberPath="Name" Height="28" MinHeight="28" Padding="6,0" VerticalContentAlignment="Center"
                                      Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,7,10,7">
                            <TextBlock Text="Fecha de compra" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,0,0,3" />
                            <DatePicker SelectedDate="{Binding PurchaseDate}" Height="28" Padding="5,0" VerticalContentAlignment="Center"
                                        Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="9" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" Margin="0,0,0,4" />
                            <Button Content="Registrar compra" Command="{Binding RegisterPurchaseCommand}"
                                    Height="34" Padding="12,0" Background="{StaticResource RocaMayaBlackPrimaryBrush}" BorderThickness="0" Foreground="White"
                                    FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBox Grid.Row="1" Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="34" Padding="10,0" Margin="0,0,0,8" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                         ToolTip="Filtrar productos por nombre o ID; las cantidades escritas se conservan" />

                <DataGrid Grid.Row="2" ItemsSource="{Binding ProductRowsView}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0" Background="White"
                          BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0" FontSize="11"
                          HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}" VerticalGridLinesBrush="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Name}" Width="1.5*" IsReadOnly="True" />
                        <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="0.7*" IsReadOnly="True" />
                        <DataGridTextColumn Header="EXISTENCIA" Binding="{Binding StockText}" Width="0.65*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="CANTIDAD" Width="0.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                       Height="30" Padding="5,0" VerticalContentAlignment="Center"
                                                       HorizontalContentAlignment="Center" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="COSTO UNIT." Width="0.9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBox Text="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}"
                                                       Height="30" Padding="5,0" VerticalContentAlignment="Center"
                                                       HorizontalContentAlignment="Right" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="VENCE" Width="1.05*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><DatePicker SelectedDate="{Binding ExpirationDate, UpdateSourceTrigger=PropertyChanged}"
                                                          Height="28" Padding="5,0" VerticalContentAlignment="Center"
                                                          Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Background="{StaticResource RocaMayaBluePrimaryBrush}" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Total de compra" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding PurchaseTotalText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" Margin="0,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Margin="0,0,0,6" Padding="12,9" Background="{StaticResource RocaMayaBlueSurfaceBrush}"
                        BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Compras recientes" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                </Border>
                <TextBox Grid.Row="1" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" Padding="10,0" Margin="0,0,0,10" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}"
                         ToolTip="Buscar por proveedor, número o fecha" />
                <Grid Grid.Row="2" Background="White">
                    <Border BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1,0,0" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PurchasesView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="58" Margin="10,0" >
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Supplier.Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                                <TextBlock Text="{Binding Number, StringFormat='Compra {0}'}" Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding DateText}" Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" VerticalAlignment="Center" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                                        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource RocaMayaDividerBrush}" Grid.ColumnSpan="2" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
          </Grid>
          </TabItem>
          <TabItem Header="Consulta de variación de costos">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="58" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}" Padding="12,8" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" Background="#193A52" CornerRadius="4" VerticalAlignment="Center"><Image Source="{StaticResource RocaMayaLogo}" Width="24" Height="24" Stretch="Uniform" /></Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PurchaseReportIdentity}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                            <TextBlock Text="Consulta de compras y variación de costos por proveedor" Margin="0,1,0,0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                            <TextBlock Text="{Binding PurchaseReportSubtitle}" Margin="0,1,0,0" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                            <TextBlock Text="Área responsable: Bodega y gerencia" Margin="0,1,0,0" FontSize="8" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                            <TextBlock Text="{Binding PurchaseReportIssuedAtText}" Margin="0,1,0,0" FontSize="8" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Desde" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                    <DatePicker Grid.Column="1" SelectedDate="{Binding ReportStartDate, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                    <TextBlock Grid.Column="2" Text="Hasta" Margin="12,0,7,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                    <DatePicker Grid.Column="3" SelectedDate="{Binding ReportEndDate, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding ReportSupplierNames}" SelectedItem="{Binding SelectedReportSupplier}" Height="32" Margin="12,0,6,0" VerticalContentAlignment="Center" ToolTip="Filtrar por proveedor" />
                    <TextBox Grid.Column="5" Text="{Binding ReportProductSearchText, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8,0" Margin="6,0" VerticalContentAlignment="Center" ToolTip="Buscar producto o código" />
                    <Button Grid.Column="6" Content="Exportar PDF" Command="{Binding ExportPurchaseReportCommand}" Height="34" Padding="10,0" Margin="0,0,6,0" FontSize="10" FontWeight="SemiBold" Background="White" BorderBrush="{StaticResource RocaMayaBlueSecondaryBrush}" Cursor="Hand" />
                    <Button Grid.Column="7" Content="Imprimir" Command="{Binding PrintPurchaseReportCommand}" Height="34" Padding="10,0" FontSize="10" FontWeight="SemiBold" Background="White" BorderBrush="{StaticResource RocaMayaBlueSecondaryBrush}" Cursor="Hand" />
                </Grid>
                <Border Grid.Row="2" Background="{StaticResource RocaMayaBlueSurfaceBrush}" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="COMPRAS EN CONSULTA  " FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding PurchaseReportPurchaseCountText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" /></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="LÍNEAS DE PRODUCTO  " FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding PurchaseReportLineCountText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" /></StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="MONTO ACUMULADO  " FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding PurchaseReportTotalText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="3" Padding="8,4" Margin="0,0,0,6" Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Acumulado por proveedor:" Margin="0,0,12,0" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding PurchaseReportSupplierTotals}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                    <TextBlock Text="{Binding SupplierName}" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                    <TextBlock Text=": " FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding TotalText}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <DataGrid Grid.Row="4" ItemsSource="{Binding PurchaseCostRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}" VerticalGridLinesBrush="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding DateText}" Width="0.9*" />
                        <DataGridTextColumn Header="COMPRA" Binding="{Binding PurchaseNumber}" Width="0.7*" />
                        <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding SupplierName}" Width="1.2*" />
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductName}" Width="1.3*" />
                        <DataGridTextColumn Header="CANTIDAD" Binding="{Binding QuantityText}" Width="0.65*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" />
                        <DataGridTextColumn Header="COSTO UNITARIO" Binding="{Binding UnitCostText}" Width="1.0*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" />
                        <DataGridTextColumn Header="COSTO ANTERIOR" Binding="{Binding PreviousUnitCostText}" Width="1.1*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" />
                        <DataGridTextColumn Header="VARIACIÓN L" Binding="{Binding UnitCostDifferenceText}" Width="0.9*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" />
                        <DataGridTextColumn Header="VARIACIÓN %" Binding="{Binding UnitCostVariationText}" Width="0.8*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" />
                        <DataGridTextColumn Header="TOTAL DE LÍNEA" Binding="{Binding LineTotalText}" Width="1.0*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="5" Text="{Binding PurchaseReportActionMessage}" Margin="0,7,0,0" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
            </Grid>
          </TabItem>
        </TabControl>
    </Grid>
</UserControl>
