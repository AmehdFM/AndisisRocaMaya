<UserControl x:Class="SistemaRocaMaya.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SistemaRocaMaya.Views"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="PurchaseReportCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>
        <Style x:Key="PurchaseReportNumericCellStyle" TargetType="TextBlock" BasedOn="{StaticResource PurchaseReportCellStyle}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource AppTableHeader}" />
    </UserControl.Resources>
    <Grid Background="{StaticResource RocaMayaSurfaceBrush}" Margin="{StaticResource AppPageMargin}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource ReportHeadingSurface}">
            <DockPanel>
                <Image DockPanel.Dock="Right" Source="{StaticResource ReportWordmark}"
                       Style="{StaticResource ReportWordmarkImage}" Margin="16,0,0,0" />
                <Button DockPanel.Dock="Right" Content="＋  Crear producto" Click="CreateProduct_Click"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=PurchaseTabs}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding SelectedItem.Header, ElementName=PurchaseTabs}" Style="{StaticResource ReportHeadingText}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <TabControl x:Name="PurchaseTabs" Grid.Row="1" SelectedIndex="0" Background="Transparent" BorderThickness="0" Padding="0">
          <TabItem Header="Registrar compra">
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Margin="0,0,0,10" Background="{StaticResource RocaMayaBlueSurfaceBrush}"
                        BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="10,7,10,7">
                            <TextBlock Text="Proveedor" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                      DisplayMemberPath="Name" Height="28" MinHeight="28" Padding="6,0" VerticalContentAlignment="Center"
                                      Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,7,10,7">
                            <TextBlock Text="Fecha de compra" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,0,0,3" />
                            <DatePicker SelectedDate="{Binding PurchaseDate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,7,10,7">
                            <TextBlock Text="Factura del proveedor" FontSize="10" Margin="0,0,0,3" />
                            <TextBox Text="{Binding SupplierInvoice, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Factura del proveedor" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="9" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" Margin="0,0,0,4" />
                            <Button Style="{StaticResource AppPrimaryButton}" Content="Registrar compra" Command="{Binding RegisterPurchaseCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBox Grid.Row="1" Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="34" Padding="10,0" Margin="0,0,0,8" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                         ToolTip="Filtrar productos por nombre o ID; las cantidades escritas se conservan" />

                <DataGrid Grid.Row="2" ItemsSource="{Binding ProductRowsView}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0" Background="White"
                          BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0" FontSize="11"
                          HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}" VerticalGridLinesBrush="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Name}" Width="1.5*" IsReadOnly="True" />
                        <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="0.7*" IsReadOnly="True" />
                        <DataGridTextColumn Header="EXISTENCIA" Binding="{Binding StockText}" Width="0.65*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="CANTIDAD" HeaderStyle="{StaticResource AppCenteredTableHeader}" Width="0.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                       Height="30" Padding="5,0" VerticalContentAlignment="Center"
                                                       TextAlignment="Center" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="COSTO UNIT." HeaderStyle="{StaticResource AppRightTableHeader}" Width="0.9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBox Text="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}"
                                                       Height="30" Padding="5,0" VerticalContentAlignment="Center"
                                                       TextAlignment="Right" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="VENCE" Width="1.05*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><DatePicker SelectedDate="{Binding ExpirationDate, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Background="{StaticResource RocaMayaBluePrimaryBrush}" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Total de compra" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding PurchaseTotalText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" Margin="0,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Margin="0,0,0,6" Padding="12,9" Background="{StaticResource RocaMayaBlueSurfaceBrush}"
                        BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Compras recientes" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                </Border>
                <TextBox Grid.Row="1" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" Padding="10,0" Margin="0,0,0,10" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}"
                         ToolTip="Buscar por proveedor, número o fecha" />
                <Grid Grid.Row="2" Background="White">
                    <Border BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1,0,0" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PurchasesView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="58" Margin="10,0" >
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Supplier.Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                                <TextBlock Text="{Binding Number, StringFormat='Compra {0}'}" Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding DateText}" Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" VerticalAlignment="Center" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                                        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource RocaMayaDividerBrush}" Grid.ColumnSpan="2" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
          </Grid>
          </TabItem>
          <TabItem Header="Historial de compras por proveedor">
            <Grid Margin="0,8,0,0">
                <Grid.Resources>
                    <BooleanToVisibilityConverter x:Key="PurchaseReportVisibility" />
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Desde" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                    <DatePicker Grid.Column="1" SelectedDate="{Binding ReportStartDate, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="Hasta" Margin="12,0,7,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                    <DatePicker Grid.Column="3" SelectedDate="{Binding ReportEndDate, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Style="{StaticResource AppButton}" Grid.Column="5" Content="Exportar PDF" Command="{Binding ExportPurchaseReportCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AppButton}" Grid.Column="6" Content="Imprimir" Command="{Binding PrintPurchaseReportCommand}" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Proveedor" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" IsEditable="True" TextSearch.TextPath="Name" DisplayMemberPath="Name"
                              ItemsSource="{Binding ReportSuppliers}" SelectedItem="{Binding SelectedReportSupplier}"
                              AutomationProperties.Name="Proveedor" MinHeight="32" />
                    <TextBlock Grid.Column="2" Text="Producto" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <ComboBox Grid.Column="3" IsEditable="True" TextSearch.TextPath="Name" DisplayMemberPath="Name"
                              ItemsSource="{Binding ReportProducts}" SelectedItem="{Binding SelectedReportProduct}"
                              IsEnabled="{Binding CanSelectReportProduct}" AutomationProperties.Name="Producto" MinHeight="32" />
                    <Button Grid.Column="4" Content="Mostrar" Style="{StaticResource AppPrimaryButton}"
                            Command="{Binding ShowPurchaseReportCommand}" Margin="12,0,0,0" />
                </Grid>
                <CheckBox Grid.Row="2" Content="Detalles de proveedor" IsChecked="{Binding ShowSupplierDetails}"
                          Margin="0,0,0,8" VerticalAlignment="Center" />
                <DataGrid Grid.Row="3" MinRowHeight="27" ScrollViewer.HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding PurchaseCostRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}" VerticalGridLinesBrush="Transparent">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowSupplierDetails}" Value="False" />
                                        <Condition Binding="{Binding HasPurchaseReport}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding DateText}" Width="0.9*" ElementStyle="{StaticResource PurchaseReportCellStyle}" />
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductName}" Width="1.3*" ElementStyle="{StaticResource PurchaseReportCellStyle}" />
                        <DataGridTextColumn Header="CANTIDAD" Binding="{Binding QuantityText}" Width="0.65*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                        <DataGridTextColumn Header="COSTO" Binding="{Binding UnitCostText}" Width="1.0*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotalText}" Width="1.0*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid Grid.Row="3" MinRowHeight="27" ScrollViewer.HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding PurchaseCostRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}" VerticalGridLinesBrush="Transparent">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowSupplierDetails}" Value="True" />
                                        <Condition Binding="{Binding HasPurchaseReport}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding DateText}" Width="0.9*" ElementStyle="{StaticResource PurchaseReportCellStyle}" />
                        <DataGridTextColumn Header="COMPRA" Binding="{Binding PurchaseNumber}" Width="0.7*" ElementStyle="{StaticResource PurchaseReportCellStyle}" />
                        <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding SupplierName}" Width="1.2*" ElementStyle="{StaticResource PurchaseReportCellStyle}" />
                        <DataGridTextColumn Header="FACTURA" Binding="{Binding SupplierInvoice}" Width="1.0*" ElementStyle="{StaticResource PurchaseReportCellStyle}" />
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductName}" Width="1.3*" ElementStyle="{StaticResource PurchaseReportCellStyle}" />
                        <DataGridTextColumn Header="CANTIDAD" Binding="{Binding QuantityText}" Width="0.65*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                        <DataGridTextColumn Header="COSTO UNITARIO" Binding="{Binding UnitCostText}" Width="1.0*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                        <DataGridTextColumn Header="COSTO ANTERIOR" Binding="{Binding PreviousUnitCostText}" Width="1.1*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                        <DataGridTextColumn Header="VARIACIÓN L" Binding="{Binding UnitCostDifferenceText}" Width="0.9*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                        <DataGridTextColumn Header="VARIACIÓN %" Binding="{Binding UnitCostVariationText}" Width="0.8*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                        <DataGridTextColumn Header="TOTAL DE LÍNEA" Binding="{Binding LineTotalText}" Width="1.0*" ElementStyle="{StaticResource PurchaseReportNumericCellStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="4" Visibility="{Binding HasPurchaseReport, Converter={StaticResource PurchaseReportVisibility}}" Padding="0,5" Background="{StaticResource RocaMayaBlueSurfaceBrush}" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="Compras totales" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding PurchaseReportPurchaseCountText}" FontSize="13" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" /></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="Productos totales" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding PurchaseReportLineCountText}" FontSize="13" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" /></StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="Valor total" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding PurchaseReportTotalText}" FontSize="13" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="5" Margin="0,8,0,0" Padding="8" Background="White"
                        BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="1"
                        Visibility="{Binding HasPurchaseReport, Converter={StaticResource PurchaseReportVisibility}}">
                    <Viewbox Height="175" Stretch="Uniform">
                        <views:PurchaseCostChartView Width="760" Height="230" Chart="{Binding UnitCostChart}"
                                                     AutomationProperties.Name="Costo unitario por fecha de compra" />
                    </Viewbox>
                </Border>
                <TextBlock Grid.Row="6" Text="{Binding PurchaseReportActionMessage}" Margin="0,7,0,0" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
            </Grid>
          </TabItem>
          <TabItem Header="Proveedores" Visibility="{Binding DataContext.SupplierTabVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
            <views:SuppliersView />
          </TabItem>
        </TabControl>
    </Grid>
</UserControl>
