<UserControl x:Class="SistemaRocaMaya.Views.FiadoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="PrimaryActionStyle" TargetType="Button">
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="#2A6F9E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,0" VerticalAlignment="Center">
            <TextBlock Text="P04 · Registrar fiado" FontSize="24" FontWeight="Bold" Foreground="#20394B" />
            <TextBlock Text="Selecciona al cliente y revisa el saldo antes de confirmar" Margin="0,4,0,0"
                       FontSize="12" Foreground="#718391" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="28,0,28,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Cliente" FontSize="16" FontWeight="SemiBold" Foreground="#20394B" />
                    <TextBlock Text="Busca por nombre o DNI" Margin="0,3,0,0" FontSize="11" Foreground="#718391" />
                </StackPanel>

                <TextBox Grid.Row="1" Height="44" Padding="13,0" VerticalContentAlignment="Center"
                         Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13" Background="White" BorderBrush="#D5E0E7" BorderThickness="1" />

                <Border Grid.Row="2" Margin="0,10,0,0" Background="White" BorderBrush="#DCE4E9" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ClientesFiltrados}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Padding="0" Margin="0" Background="Transparent" BorderThickness="0"
                                            HorizontalContentAlignment="Stretch" Cursor="Hand"
                                            Command="{Binding DataContext.SeleccionarClienteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" ToolTip="Seleccionar cliente">
                                        <Border x:Name="RowBackground" Padding="16,13" BorderBrush="#E8EDF1" BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstaSeleccionado}" Value="True">
                                                            <Setter Property="Background" Value="#E8F1F6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold" Foreground="#20394B" />
                                                    <TextBlock Text="{Binding Dni, StringFormat='DNI: {0}'}" Margin="0,4,0,0"
                                                               FontSize="11" Foreground="#718391" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="Saldo actual" FontSize="10" Foreground="#718391" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding SaldoPendienteTexto}" Margin="0,3,0,0" FontSize="13"
                                                               FontWeight="SemiBold" Foreground="#1F7A45" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Resumen de la cuenta" FontSize="16" FontWeight="SemiBold" Foreground="#20394B" />
                <TextBlock Text="Datos de demostración · no se guardarán" Margin="0,3,0,12" FontSize="11" Foreground="#718391" />

                <Border Background="#E7F0F5" Padding="20" BorderBrush="#D4E3EC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CLIENTE SELECCIONADO" FontSize="10" FontWeight="Bold" Foreground="#5C7484" />
                        <TextBlock Text="{Binding ClienteResumen}" Margin="0,7,0,18" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#20394B" TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Saldo pendiente actual" FontSize="12" Foreground="#526B7C" />
                            <TextBlock Grid.Column="1" Text="{Binding SaldoActualTexto}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#1F7A45" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Esta venta a crédito" FontSize="12" Foreground="#526B7C" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalVentaTexto}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#1F7A45" />
                        </Grid>
                        <Border Height="1" Background="#CADBE5" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Nuevo saldo estimado" FontSize="13" FontWeight="Bold" Foreground="#20394B" />
                            <TextBlock Grid.Column="1" Text="{Binding SaldoNuevoTexto}" FontSize="17" FontWeight="Bold"
                                       Foreground="#1F7A45" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="12,10" Background="#F7F9FA" BorderBrush="#E1E8EC" BorderThickness="1">
                    <TextBlock Text="{Binding MensajeEstado}" FontSize="12" Foreground="#526B7C" TextWrapping="Wrap" />
                </Border>

                <Border Margin="0,10,0,0" Padding="12,10" Background="#EAF4EE" BorderBrush="#CDE4D5" BorderThickness="1"
                        Visibility="{Binding ConfirmacionVisibility}">
                    <TextBlock Text="Fiado preparado para el ticket de demostración." FontSize="12"
                               FontWeight="SemiBold" Foreground="#276442" TextWrapping="Wrap" />
                </Border>

                <Button Margin="0,18,0,0" Style="{StaticResource PrimaryActionStyle}"
                        Content="Registrar fiado" Command="{Binding RegistrarFiadoCommand}"
                        AutomationProperties.Name="Registrar fiado de demostración" />
                <Button Margin="0,8,0,0" Height="48"
                        Content="{Binding DataContext.ReturnFromFiadoLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.ReturnFromFiadoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="White" BorderBrush="#D5E0E7" BorderThickness="1"
                        Foreground="#2A6F9E" FontSize="13" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
