<Window x:Class="SistemaRocaMaya.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SistemaRocaMaya.Views"
        Title="Roca Maya | Panel gerencial"
        Width="1360"
        Height="820"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="{Binding ShellWindowStyle}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#F3F6F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#27485F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A6F9E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarColumnWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#193A52" Visibility="{Binding ShellChromeVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="17,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="11" Background="#2A6F9E" VerticalAlignment="Center">
                        <TextBlock Text="RM" Foreground="White" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding SidebarTextVisibility}">
                        <TextBlock Text="ROCA MAYA" Foreground="White" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="Pulpería Santa Lucía" Foreground="#B7CBD8" FontSize="11" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="16,0,16,4" Padding="12,5" Background="#224761" CornerRadius="7"
                        Visibility="{Binding SidebarTextVisibility}">
                    <StackPanel>
                        <TextBlock Text="VISTA DE PROTOTIPO" Foreground="#AFC5D2" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="{Binding RoleLabel}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding Title}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Border Padding="12,11" CornerRadius="7" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontSize="15" Foreground="#D4E1E8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="8,0,0,0"
                                                       FontSize="13" Foreground="#E7EFF3" VerticalAlignment="Center"
                                                       Visibility="{Binding DataContext.SidebarTextVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                    </Border>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#2A6F9E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Margin="8,0,8,4">
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="SignOut_Click">
                        <StackPanel Orientation="Horizontal" Margin="12,10">
                            <TextBlock Text="↪" Width="28" Foreground="#D4E1E8" FontSize="15" HorizontalAlignment="Center" />
                            <TextBlock Text="Cerrar sesión" Foreground="#D4E1E8" FontSize="12"
                                       Visibility="{Binding SidebarTextVisibility}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding HeaderRowHeight}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8ED" BorderThickness="0,0,0,1"
                    Visibility="{Binding ShellChromeVisibility}">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Width="48" Height="48" Content="☰" FontSize="18"
                            Background="Transparent" BorderThickness="0" Foreground="#35546A"
                            ToolTip="Contraer o desplegar la barra lateral"
                            Command="{Binding ToggleSidebarCommand}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Usuario de demostración" Foreground="#314B5E" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RoleLabel}" Foreground="#6B7F8E" FontSize="11"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="30,25,30,32">
                    <StackPanel Visibility="{Binding DashboardVisibility}">
                        <TextBlock Text="Panel gerencial" FontSize="27" FontWeight="Bold" Foreground="#20394B" />
                        <TextBlock Text="Resumen de operación · Turno actual"
                                   Margin="0,5,0,22" FontSize="13" Foreground="#718391" />

                        <Border Background="White" BorderBrush="#E2E8ED" BorderThickness="0,1,0,1" Padding="0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="18,0">
                                    <TextBlock Text="VENTAS DE HOY" FontSize="10" FontWeight="Bold" Foreground="#718391" />
                                    <TextBlock Text="L 12,480.00" Margin="0,8,0,0" FontSize="25" FontWeight="Bold" Foreground="#1F7A45" />
                                    <TextBlock Text="18 ventas registradas" Margin="0,4,0,0" Foreground="#718391" FontSize="12" />
                                </StackPanel>
                                <Border Grid.Column="1" BorderBrush="#E2E8ED" BorderThickness="1,0,1,0">
                                    <StackPanel Margin="22,0">
                                        <TextBlock Text="CAJA ACTUAL" FontSize="10" FontWeight="Bold" Foreground="#718391" />
                                        <TextBlock Text="Abierta · Turno mañana" Margin="0,8,0,0" FontSize="17" FontWeight="SemiBold" Foreground="#20394B" />
                                        <TextBlock Text="Apertura: 7:00 a. m." Margin="0,5,0,0" Foreground="#718391" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="2" Margin="22,0">
                                    <TextBlock Text="PRODUCTOS POR PEDIR" FontSize="10" FontWeight="Bold" Foreground="#718391" />
                                    <TextBlock Text="6 productos" Margin="0,8,0,0" FontSize="17" FontWeight="SemiBold" Foreground="#20394B" />
                                    <TextBlock Text="Revisar existencias bajas" Margin="0,5,0,0" Foreground="#718391" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,26,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="0.85*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                <TextBlock Text="Actividad reciente" FontSize="17" FontWeight="SemiBold" Foreground="#20394B" />
                                <TextBlock Text="Movimientos registrados durante el turno" Margin="0,4,0,14" FontSize="12" Foreground="#718391" />
                                <Border Background="White" BorderBrush="#E2E8ED" BorderThickness="0,1,0,1" Padding="16,4">
                                    <StackPanel>
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Venta · Ticket 00418" Foreground="#314B5E" FontWeight="SemiBold" /><TextBlock Text="10:42 a. m. · Cajero" FontSize="11" Foreground="#718391" Margin="0,3,0,0" /></StackPanel>
                                            <TextBlock Grid.Column="1" Text="L 245.00" Foreground="#1F7A45" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Height="1" Background="#E8EDF1" />
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Abono · Cuenta de María López" Foreground="#314B5E" FontWeight="SemiBold" /><TextBlock Text="10:18 a. m. · Caja" FontSize="11" Foreground="#718391" Margin="0,3,0,0" /></StackPanel>
                                            <TextBlock Grid.Column="1" Text="L 100.00" Foreground="#1F7A45" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Height="1" Background="#E8EDF1" />
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Entrada de mercadería" Foreground="#314B5E" FontWeight="SemiBold" /><TextBlock Text="9:55 a. m. · Bodega" FontSize="11" Foreground="#718391" Margin="0,3,0,0" /></StackPanel>
                                            <TextBlock Grid.Column="1" Text="Inventario" Foreground="#5D7180" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Accesos frecuentes" FontSize="17" FontWeight="SemiBold" Foreground="#20394B" />
                                <TextBlock Text="Tareas principales" Margin="0,4,0,14" FontSize="12" Foreground="#718391" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Left"
                                        Command="{Binding NavigateCommand}" CommandParameter="{Binding PosMenuItem}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Margin="0,0,12,0" /><TextBlock Text="Abrir POS / Caja" /></StackPanel>
                                </Button>
                                <Button Margin="0,9,0,0" Padding="18,11" Background="White" BorderBrush="#D9E2E8"
                                        BorderThickness="1" Foreground="#35546A" FontSize="13" FontWeight="SemiBold" MinHeight="48"
                                        HorizontalContentAlignment="Left" Cursor="Hand"
                                        Command="{Binding NavigateCommand}" CommandParameter="{Binding InventoryMenuItem}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Margin="0,0,12,0" /><TextBlock Text="Revisar inventario" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding PlaceholderVisibility}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding CurrentSectionTitle}" FontSize="27" FontWeight="Bold" Foreground="#20394B" />
                        <TextBlock Text="Prototipo de navegación" Margin="0,6,0,22" FontSize="13" Foreground="#718391" />
                        <Border Background="White" BorderBrush="#E2E8ED" BorderThickness="0,1,0,1" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="Esta sección se detallará en su paso de diseño." FontSize="15" Foreground="#314B5E" />
                                <TextBlock Text="La navegación y los permisos son de demostración; todavía no hay operaciones conectadas."
                                           Margin="0,7,0,0" FontSize="12" Foreground="#718391" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <views:PosView Grid.Row="1" DataContext="{Binding PosViewModel}"
                           Visibility="{Binding DataContext.PosVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
            <views:FiadoView Grid.Row="1" DataContext="{Binding FiadoViewModel}"
                             Visibility="{Binding DataContext.FiadoVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
            <views:ClientesAbonosView Grid.Row="1" DataContext="{Binding ClientesAbonosViewModel}"
                                      Visibility="{Binding DataContext.ClientesAbonosVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Grid>
    </Grid>
</Window>
