<Window x:Class="SistemaRocaMaya.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SistemaRocaMaya.Views"
        Title="RocaMaya"
        Width="1360"
        Height="820"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="{Binding ShellWindowStyle}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="ShellWindow_Closing"
        Background="#F3F6F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#27485F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A6F9E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarSurface" Grid.Column="0" Width="232" Background="#193A52"
                Visibility="{Binding ShellChromeVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="8,0,4,0" Padding="10,5"
                            Background="#224761" CornerRadius="7"
                            VerticalAlignment="Center"
                            Visibility="{Binding SidebarTextVisibility}">
                        <StackPanel>
                            <TextBlock Text="VISTA DE PROTOTIPO" Foreground="#AFC5D2"
                                       FontSize="9" FontWeight="Bold" />
                            <TextBlock Text="{Binding RoleLabel}" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="0" Grid.ColumnSpan="2" Margin="0" Width="32" Height="36"
                            HorizontalAlignment="{Binding SidebarToggleAlignment}"
                            Style="{StaticResource NavigationButtonStyle}"
                            ToolTip="Contraer o desplegar la barra lateral"
                            Click="ToggleSidebar_Click">
                        <Border Height="36">
                        <TextBlock Text="☰" FontSize="18" Foreground="#D4E1E8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Width" Value="7" />
                            <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
                            <Setter Property="Margin" Value="0,4,2,4" />
                        </Style>
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding Title}"
                                            AutomationProperties.Name="{Binding Title}">
                                        <Border Padding="10,11" CornerRadius="7" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" FontSize="15" Foreground="#D4E1E8"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="8,0,0,0"
                                                           FontSize="13" Foreground="#E7EFF3" VerticalAlignment="Center"
                                                           Visibility="{Binding DataContext.SidebarTextVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <TextBlock Grid.Column="2" Text="{Binding ExpandGlyph}" Margin="6,0,2,0"
                                                           FontSize="14" Foreground="#D4E1E8" VerticalAlignment="Center"
                                                           Visibility="{Binding ExpandGlyphVisibility}" />
                                            </Grid>
                                        </Border>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#2A6F9E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding Children}" Visibility="{Binding ChildrenVisibility}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="{Binding Title}"
                                                        AutomationProperties.Name="{Binding Title}">
                                                    <Border Margin="18,0,0,0" Padding="8,10" CornerRadius="7" Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="20" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Icon}" FontSize="12" Foreground="#B7CBD8"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="6,0,0,0"
                                                                       FontSize="12" Foreground="#E7EFF3" VerticalAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding DataContext.SidebarTextVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </Grid>
                                                    </Border>
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="#2A6F9E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="8,0,8,4">
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="SignOut_Click">
                        <StackPanel Orientation="Horizontal" Margin="10,10">
                            <TextBlock Text="↪" Width="28" Foreground="#D4E1E8" FontSize="15" HorizontalAlignment="Center" />
                            <TextBlock Text="Cerrar sesión" Foreground="#D4E1E8" FontSize="12"
                                       Visibility="{Binding SidebarTextVisibility}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <Grid Margin="30,8,30,32">
                    <StackPanel Visibility="Collapsed">
                        <TextBlock Text="Resumen" Margin="0,0,0,20"
                                   FontSize="27" FontWeight="Bold" Foreground="#20394B" />

                        <Border Background="White" BorderBrush="#E2E8ED" BorderThickness="0,1,0,1" Padding="0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="18,0">
                                    <TextBlock Text="VENTAS DE HOY" FontSize="10" FontWeight="Bold" Foreground="#718391" />
                                    <TextBlock Text="L 12,480.00" Margin="0,8,0,0" FontSize="25" FontWeight="Bold" Foreground="#1F7A45" />
                                    <TextBlock Text="18 ventas registradas" Margin="0,4,0,0" Foreground="#718391" FontSize="12" />
                                </StackPanel>
                                <Border Grid.Column="1" BorderBrush="#E2E8ED" BorderThickness="1,0,1,0">
                                    <StackPanel Margin="22,0">
                                        <TextBlock Text="CAJA ACTUAL" FontSize="10" FontWeight="Bold" Foreground="#718391" />
                                        <TextBlock Text="Abierta · Turno mañana" Margin="0,8,0,0" FontSize="17" FontWeight="SemiBold" Foreground="#20394B" />
                                        <TextBlock Text="Apertura: 7:00 a. m." Margin="0,5,0,0" Foreground="#718391" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="2" Margin="22,0">
                                    <TextBlock Text="PRODUCTOS POR PEDIR" FontSize="10" FontWeight="Bold" Foreground="#718391" />
                                    <TextBlock Text="6 productos" Margin="0,8,0,0" FontSize="17" FontWeight="SemiBold" Foreground="#20394B" />
                                    <TextBlock Text="Revisar existencias bajas" Margin="0,5,0,0" Foreground="#718391" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Margin="0,24,0,0">
                                <TextBlock Text="Actividad reciente" FontSize="17" FontWeight="SemiBold" Foreground="#20394B" />
                                <TextBlock Text="Movimientos registrados durante el turno" Margin="0,4,0,14" FontSize="12" Foreground="#718391" />
                                <Border Background="White" BorderBrush="#E2E8ED" BorderThickness="0,1,0,1" Padding="16,4">
                                    <StackPanel>
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Venta · Ticket 00418" Foreground="#314B5E" FontWeight="SemiBold" /><TextBlock Text="10:42 a. m. · Cajero" FontSize="11" Foreground="#718391" Margin="0,3,0,0" /></StackPanel>
                                            <TextBlock Grid.Column="1" Text="L 245.00" Foreground="#1F7A45" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Height="1" Background="#E8EDF1" />
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Abono · Cuenta de María López" Foreground="#314B5E" FontWeight="SemiBold" /><TextBlock Text="10:18 a. m. · Caja" FontSize="11" Foreground="#718391" Margin="0,3,0,0" /></StackPanel>
                                            <TextBlock Grid.Column="1" Text="L 100.00" Foreground="#1F7A45" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Height="1" Background="#E8EDF1" />
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Entrada de mercadería" Foreground="#314B5E" FontWeight="SemiBold" /><TextBlock Text="9:55 a. m. · Bodega" FontSize="11" Foreground="#718391" Margin="0,3,0,0" /></StackPanel>
                                            <TextBlock Grid.Column="1" Text="Inventario" Foreground="#5D7180" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding PlaceholderVisibility}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding CurrentSectionTitle}" FontSize="27" FontWeight="Bold" Foreground="#20394B" />
                        <Border Background="White" BorderBrush="#E2E8ED" BorderThickness="0,1,0,1" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="Esta sección se detallará en su paso de diseño." FontSize="15" Foreground="#314B5E" />
                                <TextBlock Text="La navegación y los permisos son de demostración; todavía no hay operaciones conectadas."
                                           Margin="0,7,0,0" FontSize="12" Foreground="#718391" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <views:DashboardView Grid.Row="0"
                                 Visibility="{Binding DataContext.DashboardVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

            <views:PosView Grid.Row="0" DataContext="{Binding PosViewModel}"
                           Visibility="{Binding DataContext.PosVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
            <views:FiadoView Grid.Row="0" DataContext="{Binding FiadoViewModel}"
                             Visibility="{Binding DataContext.FiadoVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
            <views:CustomersView Grid.Row="0"
                                 Visibility="{Binding DataContext.CustomersVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
            <views:CreditsView Grid.Row="0"
                               Visibility="{Binding DataContext.CreditsVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
            <views:PurchasesView Grid.Row="0"
                                 Visibility="{Binding DataContext.PurchasesVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
            <views:SuppliersView Grid.Row="0"
                                 Visibility="{Binding DataContext.SuppliersVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
            <views:InventoryView Grid.Row="0"
                                 Visibility="{Binding DataContext.InventoryVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
            <views:SalesView Grid.Row="0"
                             Visibility="{Binding DataContext.SalesVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
            <views:SettingsView Grid.Row="0"
                                Visibility="{Binding DataContext.SettingsVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
            <views:AccountingView Grid.Row="0" DataContext="{Binding AccountingViewModel}"
                                  Visibility="{Binding DataContext.AccountingVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Grid>
    </Grid>
</Window>
