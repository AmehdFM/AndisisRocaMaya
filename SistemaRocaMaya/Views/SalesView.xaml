<UserControl x:Class="SistemaRocaMaya.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource AppTableHeader}" />
    </UserControl.Resources>
    <Grid Background="{StaticResource RocaMayaSurfaceBrush}" Margin="{StaticResource AppPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource ReportHeadingSurface}">
            <DockPanel>
                <Image DockPanel.Dock="Right" Source="{StaticResource ReportWordmark}"
                       Style="{StaticResource ReportWordmarkImage}" Margin="16,0,0,0" />
                <TextBlock Text="Ventas en efectivo por fecha" Style="{StaticResource ReportHeadingText}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker Width="125" SelectedDate="{Binding StartDate}" AutomationProperties.Name="Desde" />
                <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="12,0,8,0" />
                <DatePicker Width="125" SelectedDate="{Binding EndDate}" AutomationProperties.Name="Hasta" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource AppButton}" Content="Exportar PDF" Command="{Binding ExportCashReportCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource AppButton}" Content="Imprimir" Command="{Binding PrintCashReportCommand}" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Fechas" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding SaleDates}" SelectedItem="{Binding SelectedDate, Mode=TwoWay}"
                         ItemStringFormat="{}{0:dd/MM/yyyy}" AutomationProperties.Name="Fechas de ventas y cierres"
                         BorderBrush="{StaticResource RocaMayaBorderBrush}" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="95" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CashClosingSummaries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontWeight="SemiBold" HorizontalAlignment="Right"
                           Text="{Binding DailyTotalText, StringFormat='Total efectivo del día: {0}'}" />
                <DataGrid ItemsSource="{Binding SelectedCashSales}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="White"
                          BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCTOS Y PRECIO UNITARIO" Binding="{Binding Products}" Width="2.4*" MinWidth="190">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Margin" Value="4,3" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="FECHA Y HORA" Binding="{Binding Sale.DateText}" Width="1.2*" MinWidth="112" />
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding Sale.CustomerName}" Width="1.2*" MinWidth="100" />
                        <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Quantity}" Width="0.75*" MinWidth="75" />
                        <DataGridTextColumn Header="TOTAL EFECTIVO" Binding="{Binding Sale.TotalText}" Width="1*" MinWidth="112" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding CashReportActionMessage}" Margin="0,7,0,0" FontSize="9"
                   Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
    </Grid>
</UserControl>
