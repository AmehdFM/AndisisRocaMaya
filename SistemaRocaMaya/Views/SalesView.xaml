<UserControl x:Class="SistemaRocaMaya.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBluePrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource RocaMayaSurfaceBrush}" Margin="30,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Ventas" FontSize="26" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
        </StackPanel>
        <TabControl Grid.Row="1" Margin="0,0,0,0" Background="Transparent" BorderBrush="{StaticResource RocaMayaBorderBrush}">
            <TabItem Header="Ventas">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="112" /></Grid.RowDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="10,0"
                             VerticalContentAlignment="Center" Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                             ToolTip="Buscar por ticket, cliente, fecha o método de pago" />
                    <DataGrid Grid.Row="1" Margin="0,10,0,10" ItemsSource="{Binding Sales}"
                              SelectedItem="{Binding SelectedSale}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                              Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}" VerticalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TICKET" Binding="{Binding Ticket}" Width="0.8*" />
                            <DataGridTextColumn Header="FECHA" Binding="{Binding DateText}" Width="1.3*" />
                            <DataGridTextColumn Header="CLIENTE" Binding="{Binding CustomerName}" Width="1.5*" />
                            <DataGridTextColumn Header="PAGO" Binding="{Binding PaymentText}" Width="0.8*" />
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalText}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Background="{StaticResource RocaMayaBlueSurfaceBrush}"
                            BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="Detalle de la venta seleccionada" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedSaleLines}" Margin="0,5,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                                                <TextBlock Text="{Binding ProductName}" FontSize="10" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                                <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Quantity}" FontSize="10" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                                <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding LineTotalText}" FontSize="10" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Cierres de caja">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
                    <TextBox Grid.ColumnSpan="2" Text="{Binding SessionSearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="10,0"
                             VerticalContentAlignment="Center" Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                             ToolTip="Buscar cierres por fecha de apertura o cierre" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CashSessions}" SelectedItem="{Binding SelectedSession}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" RowHeaderWidth="0" Background="White"
                              BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal" Margin="0,0,12,0"
                              HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}" VerticalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="APERTURA" Binding="{Binding OpenedText}" Width="1.3*" />
                            <DataGridTextColumn Header="CIERRE" Binding="{Binding ClosedText}" Width="1.3*" />
                            <DataGridTextColumn Header="EFECTIVO CONTADO" Binding="{Binding ClosingAmountText}" Width="1*" />
                            <DataGridTextColumn Header="DIFERENCIA" Binding="{Binding DifferenceText}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" Padding="14"
                            Background="{StaticResource RocaMayaBlueSurfaceBrush}"
                            BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Sesión seleccionada" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SelectedSession.OpeningAmountText, StringFormat='Fondo inicial: {0}'}" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                        <TextBlock Text="{Binding SelectedSession.CashSales, StringFormat='Ventas al contado: L {0:N2}'}" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                        <TextBlock Text="{Binding SelectedSession.ExpectedAmountText, StringFormat='Efectivo esperado: {0}'}" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                        <TextBlock Text="{Binding SelectedSession.ClosingAmountText, StringFormat='Efectivo contado: {0}'}" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                        <TextBlock Text="{Binding SelectedSession.DifferenceText, StringFormat='Diferencia: {0}'}" Margin="0,6,0,0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                    </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
