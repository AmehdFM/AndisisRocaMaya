<UserControl x:Class="SistemaRocaMaya.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBluePrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource RocaMayaSurfaceBrush}" Margin="30,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource ReportHeadingSurface}">
            <DockPanel>
                <Image DockPanel.Dock="Right" Source="{StaticResource ReportWordmark}" Margin="16,0,0,0">
                    <Image.Style>
                        <Style TargetType="Image" BasedOn="{StaticResource ReportWordmarkImage}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=SalesTabs}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ReportHeadingText}">
                            <Setter Property="Text" Value="Ventas" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=SalesTabs}" Value="1">
                                    <Setter Property="Text" Value="Ventas en efectivo por turno" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
        <TabControl x:Name="SalesTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabItem Header="Ventas">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="112" /></Grid.RowDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="10,0"
                             VerticalContentAlignment="Center" Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                             ToolTip="Buscar por ticket, cliente, fecha o método de pago" />
                    <DataGrid Grid.Row="1" Margin="0,10,0,10" ItemsSource="{Binding Sales}"
                              SelectedItem="{Binding SelectedSale}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                              Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}" VerticalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TICKET" Binding="{Binding Ticket}" Width="0.8*" />
                            <DataGridTextColumn Header="FECHA" Binding="{Binding DateText}" Width="1.3*" />
                            <DataGridTextColumn Header="CLIENTE" Binding="{Binding CustomerName}" Width="1.5*" />
                            <DataGridTextColumn Header="PAGO" Binding="{Binding PaymentText}" Width="0.8*" />
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalText}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Background="{StaticResource RocaMayaBlueSurfaceBrush}"
                            BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="Detalle de la venta seleccionada" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedSaleLines}" Margin="0,5,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                                                <TextBlock Text="{Binding ProductName}" FontSize="10" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                                <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Quantity}" FontSize="10" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                                <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding LineTotalText}" FontSize="10" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Cierres de caja">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Desde" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                        <DatePicker Grid.Column="1" SelectedDate="{Binding SessionStartDate, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                        <TextBlock Grid.Column="2" Text="Hasta" Margin="12,0,7,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                        <DatePicker Grid.Column="3" SelectedDate="{Binding SessionEndDate, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                        <TextBox Grid.Column="4" Text="{Binding SessionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="12,0" Height="32" Padding="9,0" VerticalContentAlignment="Center"
                                 ToolTip="Buscar cierre por fecha u número de caja" />
                        <Button Grid.Column="5" Content="Exportar PDF" Command="{Binding ExportCashReportCommand}"
                                Height="34" Padding="12,0" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"
                                Background="White" BorderBrush="{StaticResource RocaMayaBlueSecondaryBrush}" Cursor="Hand" />
                        <Button Grid.Column="6" Content="Imprimir" Command="{Binding PrintCashReportCommand}"
                                Height="34" Padding="12,0" FontSize="11" FontWeight="SemiBold"
                                Background="White" BorderBrush="{StaticResource RocaMayaBlueSecondaryBrush}" Cursor="Hand" />
                    </Grid>
                    <DataGrid Grid.Row="1" MaxHeight="148" ItemsSource="{Binding CashSessions}"
                              SelectedItem="{Binding SelectedSession}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="White"
                              BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}" VerticalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="APERTURA" Binding="{Binding OpenedText}" Width="1.1*" />
                            <DataGridTextColumn Header="CIERRE" Binding="{Binding ClosedText}" Width="1.1*" />
                            <DataGridTextColumn Header="ESPERADO" Binding="{Binding ExpectedAmountText}" Width="1*" />
                            <DataGridTextColumn Header="CONTADO" Binding="{Binding ClosingAmountText}" Width="1*" />
                            <DataGridTextColumn Header="DIFERENCIA" Binding="{Binding DifferenceText}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,10,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="FONDO INICIAL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedSession.OpeningAmountText, TargetNullValue='L 0.00'}" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="VENTAS EN EFECTIVO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedSession.CashSales, StringFormat='L {0:N2}', TargetNullValue='L 0.00'}" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="ESPERADO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedSession.ExpectedAmountText, TargetNullValue='L 0.00'}" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="CONTADO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedSession.ClosingAmountText, TargetNullValue='L 0.00'}" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="DIFERENCIA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedSession.DifferenceText, TargetNullValue='L 0.00'}" Margin="0,3,0,0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" /></StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding SelectedCashSales}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="White"
                              BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}" VerticalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TICKET" Binding="{Binding Ticket}" Width="0.9*" />
                            <DataGridTextColumn Header="FECHA Y HORA" Binding="{Binding DateText}" Width="1.3*" />
                            <DataGridTextColumn Header="CLIENTE" Binding="{Binding CustomerName}" Width="1.2*" />
                            <DataGridTextColumn Header="ARTÍCULOS" Binding="{Binding Lines.Count}" Width="0.8*" />
                            <DataGridTextColumn Header="TOTAL EFECTIVO" Binding="{Binding TotalText}" Width="1.1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="4" Text="{Binding CashReportActionMessage}" Margin="0,7,0,0" FontSize="9"
                               Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
