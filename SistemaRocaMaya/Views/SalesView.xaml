<UserControl x:Class="SistemaRocaMaya.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBluePrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource RocaMayaSurfaceBrush}" Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource ReportHeadingSurface}">
            <DockPanel>
                <Image DockPanel.Dock="Right" Source="{StaticResource ReportWordmark}"
                       Style="{StaticResource ReportWordmarkImage}" Margin="16,0,0,0" />
                <TextBlock Text="Ventas en efectivo por turno" Style="{StaticResource ReportHeadingText}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" />
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Desde" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
            <DatePicker Grid.Column="1" SelectedDate="{Binding SessionStartDate, UpdateSourceTrigger=PropertyChanged}" Height="30" />
            <TextBlock Grid.Column="2" Text="Hasta" Margin="12,0,7,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
            <DatePicker Grid.Column="3" SelectedDate="{Binding SessionEndDate, UpdateSourceTrigger=PropertyChanged}" Height="30" />
            <Button Grid.Column="5" Content="Exportar PDF" Command="{Binding ExportCashReportCommand}"
                    Height="34" Padding="12,0" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"
                    Background="White" BorderBrush="{StaticResource RocaMayaBlueSecondaryBrush}" Cursor="Hand" />
            <Button Grid.Column="6" Content="Imprimir" Command="{Binding PrintCashReportCommand}"
                    Height="34" Padding="12,0" FontSize="11" FontWeight="SemiBold"
                    Background="White" BorderBrush="{StaticResource RocaMayaBlueSecondaryBrush}" Cursor="Hand" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>
            <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding CashSessions}"
                      SelectedItem="{Binding SelectedSession}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="White"
                      BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}" VerticalGridLinesBrush="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="APERTURA" Binding="{Binding OpenedText}" Width="1.1*" MinWidth="100" />
                    <DataGridTextColumn Header="CIERRE" Binding="{Binding ClosedText}" Width="1.1*" MinWidth="100" />
                    <DataGridTextColumn Header="ESPERADO" Binding="{Binding ExpectedAmountText}" Width="1*" MinWidth="75" />
                    <DataGridTextColumn Header="CONTADO" Binding="{Binding ClosingAmountText}" Width="1*" MinWidth="75" />
                    <DataGridTextColumn Header="DIFERENCIA" Binding="{Binding DifferenceText}" Width="1*" MinWidth="75" />
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,8">
                    <StackPanel Margin="0,0,14,4"><TextBlock Text="FONDO INICIAL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedSession.OpeningAmountText, TargetNullValue='L 0.00'}" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                    <StackPanel Margin="0,0,14,4"><TextBlock Text="VENTAS EN EFECTIVO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedSession.CashSales, StringFormat='L {0:N2}', TargetNullValue='L 0.00'}" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                    <StackPanel Margin="0,0,14,4"><TextBlock Text="ESPERADO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedSession.ExpectedAmountText, TargetNullValue='L 0.00'}" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                    <StackPanel Margin="0,0,14,4"><TextBlock Text="CONTADO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedSession.ClosingAmountText, TargetNullValue='L 0.00'}" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                    <StackPanel Margin="0,0,14,4"><TextBlock Text="DIFERENCIA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" /><TextBlock Text="{Binding SelectedSession.DifferenceText, TargetNullValue='L 0.00'}" Margin="0,3,0,0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" /></StackPanel>
                </WrapPanel>
                <DataGrid Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding SelectedCashSales}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="White"
                          BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}" VerticalGridLinesBrush="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TICKET" Binding="{Binding Ticket}" Width="0.9*" />
                        <DataGridTextColumn Header="FECHA Y HORA" Binding="{Binding DateText}" Width="1.3*" MinWidth="105" />
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding CustomerName}" Width="1.2*" />
                        <DataGridTextColumn Header="ARTÍCULOS" Binding="{Binding Lines.Count}" Width="0.8*" />
                        <DataGridTextColumn Header="TOTAL EFECTIVO" Binding="{Binding TotalText}" Width="1.1*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding CashReportActionMessage}" Margin="0,7,0,0" FontSize="9"
                   Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
    </Grid>
</UserControl>
