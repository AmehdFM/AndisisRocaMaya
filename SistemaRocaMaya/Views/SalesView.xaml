<UserControl x:Class="SistemaRocaMaya.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource AppTableHeader}" />
        <Style x:Key="SalesNumericCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource RocaMayaSurfaceBrush}" Margin="{StaticResource AppPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource ReportHeadingSurface}">
            <DockPanel>
                <Image DockPanel.Dock="Right" Source="{StaticResource ReportWordmark}"
                       Style="{StaticResource ReportWordmarkImage}" Margin="16,0,0,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Ventas en efectivo por fecha" Style="{StaticResource ReportHeadingText}" />
                    <TextBlock Text="{Binding ReportContext}" Margin="0,4,0,0"
                               Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker Width="125" SelectedDate="{Binding StartDate}" AutomationProperties.Name="Desde" />
                <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="12,0,8,0" />
                <DatePicker Width="125" SelectedDate="{Binding EndDate}" AutomationProperties.Name="Hasta" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource AppButton}" Content="Exportar PDF" Command="{Binding ExportCashReportCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource AppButton}" Content="Imprimir" Command="{Binding PrintCashReportCommand}" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Fechas" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding SaleDates}" SelectedItem="{Binding SelectedDate, Mode=TwoWay}"
                         ItemStringFormat="{}{0:dd/MM/yyyy}" AutomationProperties.Name="Fechas de ventas y cierres"
                         BorderBrush="{StaticResource RocaMayaBorderBrush}" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding CashSummaryCards}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}" Padding="8" Margin="0,0,4,0"
                                    BorderBrush="{StaticResource RocaMayaBlueSecondaryBrush}" BorderThickness="2,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="11" />
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DataGrid ItemsSource="{Binding SelectedCashSales}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="White"
                          BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource RocaMayaDividerBrush}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StartsGroup}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
                                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="HORA" Binding="{Binding Time}" Width="0.65*" MinWidth="54" />
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding Customer}" Width="1.4*" MinWidth="100" />
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Line.ProductName}" Width="2.2*" MinWidth="125">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Margin" Value="4,3" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PRECIO UNITARIO" Binding="{Binding UnitPrice}" Width="1.1*" MinWidth="104"
                                            ElementStyle="{StaticResource SalesNumericCell}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                        <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Line.Quantity}" Width="0.75*" MinWidth="72"
                                            ElementStyle="{StaticResource SalesNumericCell}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding Line.LineTotalText}" Width="1*" MinWidth="85"
                                            ElementStyle="{StaticResource SalesNumericCell}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding CashReportActionMessage}" Margin="0,7,0,0" FontSize="9"
                   Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
    </Grid>
</UserControl>
