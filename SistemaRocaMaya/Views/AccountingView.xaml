<UserControl x:Class="SistemaRocaMaya.Views.AccountingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBluePrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RocaMayaBlueSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatementDataGridRowStyle" TargetType="{x:Type DataGridRow}"
               BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RocaMayaSurfaceBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RocaMayaBlueSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource RocaMayaDividerBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeight" Value="40" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource RocaMayaSurfaceBrush}" Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelectedSection}" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding PeriodLabel}" FontSize="11"
                       Foreground="{StaticResource RocaMayaTextSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding SummaryVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}"
                                BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1">
                            <ItemsControl ItemsSource="{Binding SummaryMetrics}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,12" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,1,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Value}" Margin="0,5,0,0" FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="16,13" Background="White"
                                BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="190" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Ingresos y egresos" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Border Width="9" Height="9" Background="{StaticResource RocaMayaBlueSecondaryBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Ingresos" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="9" Height="9" Background="{StaticResource RocaMayaBluePrimaryBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Costos y gastos" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Height="160" Margin="0,0,12,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <TextBlock Text="40 mil" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                        <TextBlock Text="30 mil" Margin="0,21,0,0" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                        <TextBlock Text="20 mil" Margin="0,21,0,0" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                        <TextBlock Text="10 mil" Margin="0,21,0,0" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" Height="174">
                                        <Grid Margin="0,0,0,22">
                                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Border Grid.Row="0" BorderBrush="{StaticResource RocaMayaDividerBrush}" BorderThickness="0,0,0,1" />
                                            <Border Grid.Row="1" BorderBrush="{StaticResource RocaMayaDividerBrush}" BorderThickness="0,0,0,1" />
                                            <Border Grid.Row="2" BorderBrush="{StaticResource RocaMayaDividerBrush}" BorderThickness="0,0,0,1" />
                                            <Border Grid.Row="3" BorderBrush="{StaticResource RocaMayaDividerBrush}" BorderThickness="0,0,0,1" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding PeriodPerformance}" Margin="0,0,4,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="174">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24">
                                                            <Border Width="18" Height="{Binding SalesBarHeight}" Background="{StaticResource RocaMayaBlueSecondaryBrush}" Margin="0,0,4,0" />
                                                            <Border Width="18" Height="{Binding CostsBarHeight}" Background="{StaticResource RocaMayaBluePrimaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Month}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                                   Margin="0,0,0,3" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Text="Movimientos recientes" Margin="0,18,0,8" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                        <DataGrid ItemsSource="{Binding JournalEntries}" Height="230">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Date}" Width="1.0*" />
                                <DataGridTextColumn Header="REFERENCIA" Binding="{Binding Reference}" Width="0.9*" />
                                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Description}" Width="1.5*" />
                                <DataGridTextColumn Header="CUENTA" Binding="{Binding Account}" Width="1.3*" />
                                <DataGridTextColumn Header="DEBE" Binding="{Binding Debit}" Width="0.8*" />
                                <DataGridTextColumn Header="HABER" Binding="{Binding Credit}" Width="0.8*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <DataGrid ItemsSource="{Binding JournalEntries}" Visibility="{Binding JournalVisibility}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding Date}" Width="1.0*" />
                    <DataGridTextColumn Header="REFERENCIA" Binding="{Binding Reference}" Width="0.9*" />
                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Description}" Width="1.5*" />
                    <DataGridTextColumn Header="CUENTA" Binding="{Binding Account}" Width="1.3*" />
                    <DataGridTextColumn Header="DEBE" Binding="{Binding Debit}" Width="0.8*" />
                    <DataGridTextColumn Header="HABER" Binding="{Binding Credit}" Width="0.8*" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Visibility="{Binding LedgerVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}" BorderBrush="{StaticResource RocaMayaBorderBrush}"
                        BorderThickness="0,1" Padding="14,0" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock Text="Caja" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                        <TextBlock Text="L 8,020.00" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15"
                                   Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" FontWeight="Bold" DockPanel.Dock="Right" />
                    </DockPanel>
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding LedgerEntries}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding Date}" Width="1.0*" />
                        <DataGridTextColumn Header="CONCEPTO" Binding="{Binding Description}" Width="1.6*" />
                        <DataGridTextColumn Header="DEBE" Binding="{Binding Debit}" Width="1.0*" />
                        <DataGridTextColumn Header="HABER" Binding="{Binding Credit}" Width="1.0*" />
                        <DataGridTextColumn Header="SALDO" Binding="{Binding Balance}" Width="1.0*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Visibility="{Binding KardexVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}" BorderBrush="{StaticResource RocaMayaBorderBrush}"
                        BorderThickness="0,1" Padding="14,0" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding KardexProductLabel}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="PEPS" Margin="0,0,22,0" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding KardexClosingStock}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                    </Grid>
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding KardexMovements}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding Date}" Width="1.0*" />
                        <DataGridTextColumn Header="MOVIMIENTO" Binding="{Binding Description}" Width="1.6*" />
                        <DataGridTextColumn Header="LOTE" Binding="{Binding Lot}" Width="0.9*" />
                        <DataGridTextColumn Header="ENTRADA" Binding="{Binding Entry}" Width="0.7*" />
                        <DataGridTextColumn Header="SALIDA" Binding="{Binding Exit}" Width="0.7*" />
                        <DataGridTextColumn Header="EXISTENCIA" Binding="{Binding Balance}" Width="0.8*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Visibility="{Binding FinancialPositionVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}" BorderBrush="{StaticResource RocaMayaBorderBrush}"
                        BorderThickness="0,1" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding FinancialPositionMetrics}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,8" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,1,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Value}" Margin="0,4,0,0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding FinancialPositionLines}" RowStyle="{StaticResource StatementDataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="GRUPO" Binding="{Binding Group}" Width="1.2*" />
                        <DataGridTextColumn Header="CUENTA" Binding="{Binding Account}" Width="2.0*" />
                        <DataGridTextColumn Header="SALDO" Binding="{Binding Amount}" Width="1.0*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Visibility="{Binding IncomeStatementVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}" BorderBrush="{StaticResource RocaMayaBorderBrush}"
                        BorderThickness="0,1" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding IncomeMetrics}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,8" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,1,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Value}" Margin="0,4,0,0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding IncomeStatementLines}" RowStyle="{StaticResource StatementDataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RUBRO" Binding="{Binding Group}" Width="1.5*" />
                        <DataGridTextColumn Header="CONCEPTO" Binding="{Binding Account}" Width="2.2*" />
                        <DataGridTextColumn Header="MONTO" Binding="{Binding Amount}" Width="1.0*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
