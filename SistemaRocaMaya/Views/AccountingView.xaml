<UserControl x:Class="SistemaRocaMaya.Views.AccountingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="AccountingReportHeader" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Style="{StaticResource ReportHeadingSurface}">
                            <DockPanel>
                                <Image DockPanel.Dock="Right" Source="{StaticResource ReportWordmark}"
                                       Style="{StaticResource ReportWordmarkImage}" Margin="16,0,0,0" />
                                <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource ReportHeadingText}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBluePrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="NumericCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ReportActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
        </Style>
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RocaMayaBlueSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatementDataGridRowStyle" TargetType="{x:Type DataGridRow}"
               BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RocaMayaSurfaceBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RocaMayaBlueSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource RocaMayaDividerBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeight" Value="40" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource RocaMayaSurfaceBrush}" Margin="30,20">
        <Grid>
            <Grid Visibility="{Binding SummaryVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ContentControl Style="{StaticResource AccountingReportHeader}" Content="Ratios e Indicadores Financieros" />
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding IndicatorPeriodLabel}" Style="{StaticResource ReportMetadataText}" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding StatementIssuedAtText}" Style="{StaticResource ReportMetadataText}" />
                        </WrapPanel>
                        <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}"
                                BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1">
                            <ItemsControl ItemsSource="{Binding SummaryMetrics}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,12" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,1,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Value}" Margin="0,5,0,0" FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="16,13" Background="White"
                                BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="190" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Ventas y costo de ventas por mes" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                        <TextBlock Text="{Binding ChartScaleUnitText}" Margin="0,2,0,0" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Border Width="9" Height="9" Background="{StaticResource RocaMayaBlueSecondaryBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Ingresos" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="9" Height="9" Background="{StaticResource RocaMayaBluePrimaryBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Costo de ventas" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Height="160" Margin="0,0,12,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ChartScaleTopText}" FontSize="8" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ChartScaleThreeQuarterText}" Margin="0,18,0,0" FontSize="8" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ChartScaleMiddleText}" Margin="0,18,0,0" FontSize="8" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ChartScaleQuarterText}" Margin="0,18,0,0" FontSize="8" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" Height="174">
                                        <Grid Margin="0,0,0,22">
                                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Border Grid.Row="0" BorderBrush="{StaticResource RocaMayaDividerBrush}" BorderThickness="0,0,0,1" />
                                            <Border Grid.Row="1" BorderBrush="{StaticResource RocaMayaDividerBrush}" BorderThickness="0,0,0,1" />
                                            <Border Grid.Row="2" BorderBrush="{StaticResource RocaMayaDividerBrush}" BorderThickness="0,0,0,1" />
                                            <Border Grid.Row="3" BorderBrush="{StaticResource RocaMayaDividerBrush}" BorderThickness="0,0,0,1" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding PeriodPerformance}" Margin="0,0,4,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="174">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24">
                                                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,3,0">
                                                                <TextBlock Text="{Binding SalesCompactText}" ToolTip="{Binding SalesTooltip}" FontSize="7" TextAlignment="Center" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                                <Border Width="13" Height="{Binding SalesBarHeight}" Background="{StaticResource RocaMayaBlueSecondaryBrush}" ToolTip="{Binding SalesTooltip}" />
                                                            </StackPanel>
                                                            <StackPanel VerticalAlignment="Bottom">
                                                                <TextBlock Text="{Binding CostsCompactText}" ToolTip="{Binding CostsTooltip}" FontSize="7" TextAlignment="Center" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                                <Border Width="13" Height="{Binding CostsBarHeight}" Background="{StaticResource RocaMayaBluePrimaryBrush}" ToolTip="{Binding CostsTooltip}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Month}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                                   Margin="0,0,0,3" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Fórmulas e interpretación" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                            <DataGrid Grid.Row="2" ItemsSource="{Binding ManagementIndicators}" Height="150" HeadersVisibility="Column" RowHeight="42">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="INDICADOR" Binding="{Binding Name}" Width="1.0*" />
                                    <DataGridTextColumn Header="RESULTADO" Binding="{Binding Value}" Width="0.8*" />
                                    <DataGridTemplateColumn Header="REPRESENTACIÓN" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" ToolTip="{Binding VisualScale}">
                                                    <Border Width="90" Height="8" CornerRadius="4" Background="{StaticResource RocaMayaBlueSurfaceBrush}" HorizontalAlignment="Left">
                                                        <Border Width="{Binding VisualWidth}" Height="8" CornerRadius="4" Background="{StaticResource RocaMayaBlueSecondaryBrush}" HorizontalAlignment="Left" />
                                                    </Border>
                                                    <TextBlock Text="{Binding VisualScale}" Margin="0,2,0,0" FontSize="7" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="FÓRMULA" Binding="{Binding Formula}" Width="1.6*" />
                                    <DataGridTextColumn Header="¿QUÉ SIGNIFICA?" Binding="{Binding Explanation}" Width="2.5*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <TextBlock Text="Movimientos recientes" Margin="0,18,0,8" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                        <DataGrid ItemsSource="{Binding JournalEntries}" Height="230">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding DateText}" Width="1.0*" />
                                <DataGridTextColumn Header="REFERENCIA" Binding="{Binding Reference}" Width="0.9*" />
                                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Description}" Width="1.5*" />
                                <DataGridTextColumn Header="CUENTA" Binding="{Binding Account}" Width="1.3*" />
                                <DataGridTextColumn Header="DEBE" Binding="{Binding DebitText}" Width="0.8*" ElementStyle="{StaticResource NumericCellTextStyle}" />
                                <DataGridTextColumn Header="HABER" Binding="{Binding CreditText}" Width="0.8*" ElementStyle="{StaticResource NumericCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding JournalVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl Style="{StaticResource AccountingReportHeader}" Content="Libro Diario Contable" />
                <Grid Grid.Row="1" Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Desde" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                    <DatePicker Grid.Column="1" SelectedDate="{Binding JournalStartDate, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                    <TextBlock Grid.Column="2" Text="Hasta" Margin="12,0,7,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                    <DatePicker Grid.Column="3" SelectedDate="{Binding JournalEndDate, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                    <TextBox Grid.Column="4" Text="{Binding JournalSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="12,0" Height="32" Padding="9,0" VerticalContentAlignment="Center"
                             ToolTip="Buscar por referencia, concepto o fecha" />
                    <Button Grid.Column="5" Content="Exportar PDF" Command="{Binding ExportJournalCommand}"
                            Style="{StaticResource ReportActionButtonStyle}" Margin="0,0,6,0" />
                    <Button Grid.Column="6" Content="Imprimir" Command="{Binding PrintJournalCommand}"
                            Style="{StaticResource ReportActionButtonStyle}" />
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding JournalEntries}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding DateText}" Width="0.9*" />
                        <DataGridTextColumn Header="DOCUMENTO" Binding="{Binding Reference}" Width="0.9*" />
                        <DataGridTextColumn Header="CONCEPTO" Binding="{Binding Description}" Width="1.5*" />
                        <DataGridTextColumn Header="CUENTA" Binding="{Binding Account}" Width="1.3*" />
                        <DataGridTextColumn Header="DEBE" Binding="{Binding DebitText}" Width="1.0*" ElementStyle="{StaticResource NumericCellTextStyle}" />
                        <DataGridTextColumn Header="HABER" Binding="{Binding CreditText}" Width="1.0*" ElementStyle="{StaticResource NumericCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="3" Text="{Binding JournalActionMessage}" Margin="0,7,0,0" FontSize="9"
                           Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
            </Grid>

            <Grid Visibility="{Binding LedgerVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl Style="{StaticResource AccountingReportHeader}" Content="Libro Mayor" />
                <Grid Grid.Row="1" Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" /><ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding LedgerAccounts}" SelectedItem="{Binding SelectedLedgerAccount}"
                              Height="32" VerticalContentAlignment="Center" ToolTip="Selecciona la cuenta contable" />
                    <TextBlock Grid.Column="1" Text="Desde" Margin="12,0,7,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                    <DatePicker Grid.Column="2" SelectedDate="{Binding LedgerStartDate, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                    <TextBlock Grid.Column="3" Text="Hasta" Margin="12,0,7,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                    <DatePicker Grid.Column="4" SelectedDate="{Binding LedgerEndDate, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                    <TextBox Grid.Column="5" Text="{Binding LedgerSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="12,0" Height="32" Padding="9,0" VerticalContentAlignment="Center"
                             ToolTip="Buscar por documento, concepto o fecha" />
                    <Button Grid.Column="6" Content="Exportar PDF" Command="{Binding ExportLedgerCommand}"
                            Style="{StaticResource ReportActionButtonStyle}" Margin="0,0,6,0" />
                    <Button Grid.Column="7" Content="Imprimir" Command="{Binding PrintLedgerCommand}"
                            Style="{StaticResource ReportActionButtonStyle}" />
                    <TextBlock Grid.Column="8" Text="" />
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding LedgerEntries}">
                    <DataGrid.Resources>
                        <Style x:Key="LedgerCellTextStyle" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Center" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding DateText}" Width="0.9*" ElementStyle="{StaticResource LedgerCellTextStyle}" />
                        <DataGridTextColumn Header="CONCEPTO" Binding="{Binding Description}" Width="1.6*" ElementStyle="{StaticResource LedgerCellTextStyle}" />
                        <DataGridTextColumn Header="DEBE" Binding="{Binding DebitText}" Width="1.0*" ElementStyle="{StaticResource LedgerCellTextStyle}" />
                        <DataGridTextColumn Header="HABER" Binding="{Binding CreditText}" Width="1.0*" ElementStyle="{StaticResource LedgerCellTextStyle}" />
                        <DataGridTextColumn Header="SALDO" Binding="{Binding BalanceText}" Width="1.0*" ElementStyle="{StaticResource LedgerCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="3" Text="{Binding LedgerActionMessage}" Margin="0,7,0,0" FontSize="9"
                           Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
            </Grid>

            <Grid Visibility="{Binding KardexVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ContentControl Style="{StaticResource AccountingReportHeader}" Content="Kardex de Inventario PEPS" />
                <Grid Grid.Row="1" Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="112" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="112" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Producto" Style="{StaticResource ReportMetadataText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding KardexProducts}" SelectedItem="{Binding SelectedKardexProduct}"
                              DisplayMemberPath="Name" TextSearch.TextPath="Name" IsEditable="True"
                              AutomationProperties.Name="Buscar producto por nombre" Height="32" />
                    <TextBlock Grid.Column="2" Text="Desde" Style="{StaticResource ReportMetadataText}" VerticalAlignment="Center" Margin="12,0,7,0" />
                    <DatePicker Grid.Column="3" SelectedDate="{Binding KardexStartDate, UpdateSourceTrigger=PropertyChanged}" Height="32" />
                    <TextBlock Grid.Column="4" Text="Hasta" Style="{StaticResource ReportMetadataText}" VerticalAlignment="Center" Margin="12,0,7,0" />
                    <DatePicker Grid.Column="5" SelectedDate="{Binding KardexEndDate, UpdateSourceTrigger=PropertyChanged}" Height="32" />
                    <Button Grid.Column="6" Content="Exportar PDF" Command="{Binding ExportKardexCommand}"
                            Style="{StaticResource ReportActionButtonStyle}" Margin="12,0,6,0" />
                    <Button Grid.Column="7" Content="Imprimir" Command="{Binding PrintKardexCommand}" Style="{StaticResource ReportActionButtonStyle}" />
                </Grid>
                <Border Grid.Row="2" Background="White" Padding="10,0" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"><Run Text="{Binding KardexClosingStock, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding KardexClosingValue, Mode=OneWay}" /></TextBlock>
                </Border>
                <DataGrid Grid.Row="3" ItemsSource="{Binding KardexMovements}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding DateText}" Width="100" />
                        <DataGridTextColumn Header="MOVIMIENTO" Binding="{Binding Description}" Width="190" />
                        <DataGridTextColumn Header="ENTRADA · CANT." Binding="{Binding EntryQuantity}" Width="105" ElementStyle="{StaticResource NumericCellTextStyle}" />
                        <DataGridTextColumn Header="COSTO UNIT." Binding="{Binding EntryUnitCost}" Width="100" ElementStyle="{StaticResource NumericCellTextStyle}" />
                        <DataGridTextColumn Header="COSTO TOTAL" Binding="{Binding EntryTotal}" Width="105" ElementStyle="{StaticResource NumericCellTextStyle}" />
                        <DataGridTextColumn Header="SALIDA · CANT." Binding="{Binding ExitQuantity}" Width="105" ElementStyle="{StaticResource NumericCellTextStyle}" />
                        <DataGridTextColumn Header="COSTO UNIT." Binding="{Binding ExitUnitCost}" Width="100" ElementStyle="{StaticResource NumericCellTextStyle}" />
                        <DataGridTextColumn Header="COSTO TOTAL" Binding="{Binding ExitTotal}" Width="105" ElementStyle="{StaticResource NumericCellTextStyle}" />
                        <DataGridTextColumn Header="SALDO · CANT." Binding="{Binding BalanceQuantity}" Width="105" ElementStyle="{StaticResource NumericCellTextStyle}" />
                        <DataGridTextColumn Header="COSTO UNIT." Binding="{Binding BalanceUnitCost}" Width="100" ElementStyle="{StaticResource NumericCellTextStyle}" />
                        <DataGridTextColumn Header="COSTO TOTAL" Binding="{Binding BalanceTotal}" Width="105" ElementStyle="{StaticResource NumericCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="4" Text="{Binding KardexActionMessage}" Margin="0,7,0,0" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
            </Grid>

            <Grid Visibility="{Binding FinancialPositionVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="68" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <ContentControl Style="{StaticResource AccountingReportHeader}" Content="Estado de Situación Financiera" />
                    <WrapPanel>
                        <TextBlock Text="Mes de corte" Style="{StaticResource ReportMetadataText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding ReportMonthOptions}" SelectedItem="{Binding FinancialPositionCutoffMonth}"
                                  ItemStringFormat="MMMM yyyy" Language="es-HN" AutomationProperties.Name="Mes de corte"
                                  Width="155" Height="28" Margin="0,0,12,0" />
                        <Button Content="Exportar PDF" Command="{Binding ExportFinancialPositionCommand}"
                                Style="{StaticResource ReportActionButtonStyle}" Height="28" Margin="0,0,6,0" />
                        <Button Content="Imprimir" Command="{Binding PrintFinancialPositionCommand}"
                                Style="{StaticResource ReportActionButtonStyle}" Height="28" />
                    </WrapPanel>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource RocaMayaBlueSurfaceBrush}" BorderBrush="{StaticResource RocaMayaBorderBrush}"
                        BorderThickness="0,1" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding FinancialPositionMetrics}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,8" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,1,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Value}" Margin="0,4,0,0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <DataGrid Grid.Row="2" ItemsSource="{Binding FinancialPositionLines}" RowStyle="{StaticResource StatementDataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="GRUPO" Binding="{Binding Group}" Width="1.2*" />
                        <DataGridTextColumn Header="CUENTA" Binding="{Binding Account}" Width="2.0*" />
                        <DataGridTextColumn Header="SALDO" Binding="{Binding Amount}" Width="1.0*" ElementStyle="{StaticResource NumericCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="3" Text="{Binding StatementActionMessage}" Margin="0,6,0,0" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
            </Grid>

            <ScrollViewer Visibility="{Binding IncomeStatementVisibility}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,8">
                    <ContentControl Style="{StaticResource AccountingReportHeader}" Content="Estado de Resultados" />
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Desde" Style="{StaticResource ReportMetadataText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding ReportMonthOptions}" SelectedItem="{Binding IncomeStartDate}" ItemStringFormat="MMMM yyyy"
                                  Language="es-HN" AutomationProperties.Name="Mes inicial" Width="155" Height="28" Margin="0,0,12,0" />
                        <TextBlock Text="Hasta" Style="{StaticResource ReportMetadataText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding ReportMonthOptions}" SelectedItem="{Binding IncomeEndDate}" ItemStringFormat="MMMM yyyy"
                                  Language="es-HN" AutomationProperties.Name="Mes final" Width="155" Height="28" Margin="0,0,12,0" />
                        <Button Content="Exportar PDF" Command="{Binding ExportIncomeStatementCommand}" Style="{StaticResource ReportActionButtonStyle}" Height="28" Margin="0,0,6,0" />
                        <Button Content="Imprimir" Command="{Binding PrintIncomeStatementCommand}" Style="{StaticResource ReportActionButtonStyle}" Height="28" />
                    </WrapPanel>
                    <Border BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding IncomeStatementLines}" ScrollViewer.VerticalScrollBarVisibility="Disabled" MinRowHeight="30" RowHeight="NaN" RowStyle="{StaticResource StatementDataGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Group}" Width="1.7*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Descripción" Binding="{Binding Account}" Width="2.2*" />
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Amount}" Width="1.0*" ElementStyle="{StaticResource NumericCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <TextBlock Text="{Binding StatementActionMessage}" Margin="0,6,0,0" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ReportMetadataText}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="Datos de demostración">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Evolución mensual" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding IncomeChartStatusMessage}" Margin="0,3,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ReportMetadataText}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel Margin="0,4,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="10" Height="10" Fill="{StaticResource RocaMayaBluePrimaryBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="Ventas" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="10" Height="10" Fill="#9A5B23" Margin="0,0,5,0" />
                                <TextBlock Text="Costos y gastos" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="10" Height="10" Fill="#287553" Margin="0,0,5,0" />
                                <TextBlock Text="Utilidad neta" />
                            </StackPanel>
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,24,0,0" VerticalAlignment="Top">
                                <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource RocaMayaBorderBrush}">
                                    <Grid Height="100" Margin="0,0,8,0" MinWidth="58">
                                        <TextBlock Text="{Binding IncomeChartMaximumText}" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="11" />
                                        <TextBlock Text="{Binding IncomeChartMidpointText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" />
                                        <TextBlock Text="L 0.00" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="11" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding IncomeChartMinimumText}" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="11" />
                            </StackPanel>
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding IncomeChartMonths}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel MinWidth="100">
                                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Height="24" FontWeight="SemiBold" />
                                                <Grid Height="100" Margin="12,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Column="0" Height="{Binding Sales.AboveZero}" VerticalAlignment="Bottom" Margin="2,0" Fill="{StaticResource RocaMayaBluePrimaryBrush}"
                                                               ToolTip="{Binding Sales.Amount}" />
                                                    <Rectangle Grid.Column="1" Height="{Binding Costs.AboveZero}" VerticalAlignment="Bottom" Margin="2,0" Fill="#9A5B23"
                                                               ToolTip="{Binding Costs.Amount}" />
                                                    <Rectangle Grid.Column="2" Height="{Binding NetIncome.AboveZero}" VerticalAlignment="Bottom" Margin="2,0" Fill="#287553"
                                                               ToolTip="{Binding NetIncome.Amount}" />
                                                </Grid>
                                                <Border BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1,0,0" />
                                                <Grid Height="{Binding DataContext.IncomeChartNegativeHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="12,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Column="0" Height="{Binding Sales.BelowZero}" VerticalAlignment="Top" Margin="2,0" Fill="{StaticResource RocaMayaBluePrimaryBrush}"
                                                               ToolTip="{Binding Sales.Amount}" />
                                                    <Rectangle Grid.Column="1" Height="{Binding Costs.BelowZero}" VerticalAlignment="Top" Margin="2,0" Fill="#9A5B23"
                                                               ToolTip="{Binding Costs.Amount}" />
                                                    <Rectangle Grid.Column="2" Height="{Binding NetIncome.BelowZero}" VerticalAlignment="Top" Margin="2,0" Fill="#287553"
                                                               ToolTip="{Binding NetIncome.Amount}" />
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
