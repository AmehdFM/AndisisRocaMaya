<UserControl x:Class="SistemaRocaMaya.Views.AccountingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid Background="#F3F6F8" Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding SelectedSection}" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                <TextBlock Text="{Binding SectionDescription}" Margin="0,4,0,0" FontSize="12"
                           Foreground="#526A7A" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,8" VerticalAlignment="Center"
                    Background="{StaticResource RocaMayaCreamBrush}" CornerRadius="6">
                <TextBlock Text="{Binding PeriodLabel}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Visibility="{Binding SummaryVisibility}">
                    <TextBlock Text="RESUMEN DEL PERÍODO" Margin="0,0,0,10" FontSize="10" FontWeight="Bold"
                               Foreground="#526A7A" />
                    <ItemsControl ItemsSource="{Binding SummaryMetrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#D8E3EA" BorderThickness="1" Padding="16,14" Margin="0,0,10,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold" Foreground="#526A7A" />
                                        <TextBlock Text="{Binding Value}" Margin="0,7,0,0" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" FontSize="10" Foreground="#718391" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Movimientos recientes" Margin="0,8,0,10" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                    <DataGrid ItemsSource="{Binding JournalEntries}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal" RowHeight="40" Background="White" BorderBrush="#D8E3EA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FECHA" Binding="{Binding Date}" Width="1.0*" />
                            <DataGridTextColumn Header="REFERENCIA" Binding="{Binding Reference}" Width="0.9*" />
                            <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Description}" Width="1.5*" />
                            <DataGridTextColumn Header="CUENTA" Binding="{Binding Account}" Width="1.3*" />
                            <DataGridTextColumn Header="DEBE" Binding="{Binding Debit}" Width="0.8*" />
                            <DataGridTextColumn Header="HABER" Binding="{Binding Credit}" Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <DataGrid ItemsSource="{Binding JournalEntries}" Visibility="{Binding JournalVisibility}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                      RowHeight="42" Background="White" BorderBrush="#D8E3EA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding Date}" Width="1.0*" />
                    <DataGridTextColumn Header="REFERENCIA" Binding="{Binding Reference}" Width="0.9*" />
                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Description}" Width="1.5*" />
                    <DataGridTextColumn Header="CUENTA" Binding="{Binding Account}" Width="1.3*" />
                    <DataGridTextColumn Header="DEBE" Binding="{Binding Debit}" Width="0.8*" />
                    <DataGridTextColumn Header="HABER" Binding="{Binding Credit}" Width="0.8*" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Visibility="{Binding LedgerVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{StaticResource RocaMayaCreamBrush}" Padding="12,0" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock Text="Cuenta contable" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                        <TextBlock Text="Caja" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" FontWeight="Bold" />
                    </DockPanel>
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding LedgerEntries}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal" RowHeight="42" Background="White" BorderBrush="#D8E3EA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding Date}" Width="1.0*" />
                        <DataGridTextColumn Header="CONCEPTO" Binding="{Binding Description}" Width="1.6*" />
                        <DataGridTextColumn Header="DEBE" Binding="{Binding Debit}" Width="1.0*" />
                        <DataGridTextColumn Header="HABER" Binding="{Binding Credit}" Width="1.0*" />
                        <DataGridTextColumn Header="SALDO" Binding="{Binding Balance}" Width="1.0*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Visibility="{Binding KardexVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{StaticResource RocaMayaCreamBrush}" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PRODUCTO" FontSize="9" FontWeight="Bold" Foreground="#526A7A" />
                            <TextBlock Text="{Binding KardexProductLabel}" Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="PEPS · PRIMERAS ENTRADAS, PRIMERAS SALIDAS"
                                   VerticalAlignment="Center" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                    </Grid>
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding KardexMovements}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal" RowHeight="44" Background="White" BorderBrush="#D8E3EA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding Date}" Width="1.0*" />
                        <DataGridTextColumn Header="MOVIMIENTO" Binding="{Binding Description}" Width="1.6*" />
                        <DataGridTextColumn Header="LOTE PEPS" Binding="{Binding Lot}" Width="0.9*" />
                        <DataGridTextColumn Header="ENTRADA" Binding="{Binding Entry}" Width="0.7*" />
                        <DataGridTextColumn Header="SALIDA" Binding="{Binding Exit}" Width="0.7*" />
                        <DataGridTextColumn Header="EXISTENCIA" Binding="{Binding Balance}" Width="0.8*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <DataGrid ItemsSource="{Binding FinancialPositionLines}" Visibility="{Binding FinancialPositionVisibility}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                      RowHeight="46" Background="White" BorderBrush="#D8E3EA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="GRUPO" Binding="{Binding Group}" Width="1.2*" />
                    <DataGridTextColumn Header="CUENTA" Binding="{Binding Account}" Width="2.0*" />
                    <DataGridTextColumn Header="SALDO" Binding="{Binding Amount}" Width="1.0*" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid ItemsSource="{Binding IncomeStatementLines}" Visibility="{Binding IncomeStatementVisibility}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                      RowHeight="48" Background="White" BorderBrush="#D8E3EA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="RUBRO" Binding="{Binding Group}" Width="1.5*" />
                    <DataGridTextColumn Header="CONCEPTO" Binding="{Binding Account}" Width="2.2*" />
                    <DataGridTextColumn Header="MONTO" Binding="{Binding Amount}" Width="1.0*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
