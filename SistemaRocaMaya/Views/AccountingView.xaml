<UserControl x:Class="SistemaRocaMaya.Views.AccountingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="AccountingReportHeader" TargetType="ContentControl" BasedOn="{StaticResource AppPageHeader}" />
        <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource AppTableHeader}" />
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="NumericCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ReportActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButton}" />
        <Style x:Key="FinancialPositionBarStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{StaticResource RocaMayaChartBlueBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="PASIVOS"><Setter Property="Fill" Value="{StaticResource RocaMayaChartCoralBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Name}" Value="PATRIMONIO"><Setter Property="Fill" Value="{StaticResource RocaMayaChartMintBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RocaMayaBlueSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatementDataGridRowStyle" TargetType="{x:Type DataGridRow}"
               BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RocaMayaSurfaceBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RocaMayaBlueSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource RocaMayaDividerBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="CenteredReportCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ReportTotalsPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style x:Key="KardexGroupColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppTableHeader}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Border Background="{StaticResource RocaMayaBlueSelectedBrush}">
                                <ContentPresenter Content="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <UniformGrid Grid.Row="1" Rows="1">
                                <TextBlock Text="Cantidad" Style="{StaticResource CenteredReportCell}" />
                                <TextBlock Text="Valor" Style="{StaticResource CenteredReportCell}" />
                                <TextBlock Text="Valor total" Style="{StaticResource CenteredReportCell}" />
                            </UniformGrid>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource RocaMayaSurfaceBrush}" Margin="{StaticResource AppPageMargin}">
        <Grid>
            <Grid Visibility="{Binding SummaryVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ContentControl Style="{StaticResource AccountingReportHeader}" Content="Indicadores financieros" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <Button Content="Exportar PDF" Command="{Binding ExportSummaryCommand}"
                                    Style="{StaticResource ReportActionButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="Imprimir" Command="{Binding PrintSummaryCommand}"
                                    Style="{StaticResource ReportActionButtonStyle}" />
                        </StackPanel>
                        <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}"
                                BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1">
                            <ItemsControl ItemsSource="{Binding SummaryMetrics}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,12" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,1,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Value}" Margin="0,5,0,0" FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TabControl ItemsSource="{Binding ManagementIndicators}" SelectedIndex="{Binding SelectedManagementIndicatorIndex, Mode=TwoWay}" Margin="0,8,0,0"
                                    BorderThickness="0" Background="Transparent" Padding="0">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="5,2" />
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,12,0,0">
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ThresholdLabel}" Foreground="{StaticResource RocaMayaChartTextBrush}" />
                                            <TextBlock Text="{Binding Unit, StringFormat='Unidad: {0}'}" Style="{StaticResource ReportChartAxisText}" />
                                        </DockPanel>
                                        <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                <Rectangle Width="12" Height="3" Fill="{StaticResource RocaMayaChartBlueBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="Indicador" Style="{StaticResource ReportChartAxisText}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="12" Height="3" Fill="{StaticResource RocaMayaChartPeachBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="Umbral" Style="{StaticResource ReportChartAxisText}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="150" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid MinWidth="46" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding AxisTop}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-7,0,0" Style="{StaticResource ReportChartAxisText}" />
                                                <TextBlock Text="{Binding AxisMiddle}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource ReportChartAxisText}" />
                                                <TextBlock Text="{Binding AxisBottom}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-7" Style="{StaticResource ReportChartAxisText}" />
                                            </Grid>
                                            <Viewbox Grid.Column="1" Stretch="Fill">
                                                <Canvas Width="600" Height="150" Background="{StaticResource RocaMayaBlueSurfaceBrush}">
                                                    <Path Data="M 0,0 H 600 M 0,75 H 600" Stroke="{StaticResource RocaMayaBorderBrush}" StrokeThickness="1" />
                                                    <Path Data="M 0,0 V 150 H 600" Stroke="{StaticResource RocaMayaTextSecondaryBrush}" StrokeThickness="1" />
                                                    <Path Data="{Binding ThresholdLine}" Stroke="{StaticResource RocaMayaChartPeachBrush}" StrokeThickness="1.5" StrokeDashArray="5 3" />
                                                    <Path Data="{Binding Line}" Stroke="{StaticResource RocaMayaChartBlueBrush}" StrokeThickness="2" />
                                                    <Path Data="{Binding Dots}" Fill="{StaticResource RocaMayaChartBlueBrush}" />
                                                </Canvas>
                                            </Viewbox>
                                            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Months}" Margin="0,5,0,0">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding Value}" Style="{StaticResource ReportChartValueText}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <TextBlock Text="Mes contable" HorizontalAlignment="Center"
                                                   Style="{StaticResource ReportMetadataText}" Margin="0,4,0,0" />
                                        <Border Style="{StaticResource ReportTotalsPanel}" Margin="0,12,0,3">
                                            <StackPanel>
                                                <TextBlock Text="Qué significa" FontWeight="SemiBold"
                                                           Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                                                <TextBlock Text="{Binding Definition}" TextWrapping="Wrap" FontSize="14" Margin="0,4,0,0" />
                                                <TextBlock Text="Frente al mes anterior" FontWeight="SemiBold" Margin="0,8,0,2" />
                                                <TextBlock Text="{Binding Comparison.Text}" Foreground="{StaticResource RocaMayaChartTextBrush}"
                                                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                        <TextBlock Text="{Binding SummaryActionMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Style="{StaticResource ReportMetadataText}" />

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding JournalVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ContentControl Style="{StaticResource AccountingReportHeader}" Content="Libro Diario Contable" />
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Año" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding JournalYears}" SelectedItem="{Binding SelectedJournalYear}"
                                          AutomationProperties.Name="Año" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Mes" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding JournalMonths}" DisplayMemberPath="Name" SelectedValuePath="Number"
                                          SelectedValue="{Binding SelectedJournalMonth}" AutomationProperties.Name="Mes" />
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding JournalDays}" SelectedItem="{Binding SelectedJournalDay}"
                                 AutomationProperties.Name="Libros diarios del mes">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=dd/MM/yyyy}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock Text="{Binding SelectedJournalDay, StringFormat=dd/MM/yyyy, TargetNullValue='Sin partidas en el mes'}"
                                       VerticalAlignment="Center" FontWeight="SemiBold" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <CheckBox Content="Imprimir mes entero" IsChecked="{Binding PrintWholeJournalMonth}"
                                          ToolTip="Incluye todo el mes al exportar a PDF o imprimir"
                                          VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Content="Exportar PDF" Command="{Binding ExportJournalCommand}"
                                        Style="{StaticResource ReportActionButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="Imprimir" Command="{Binding PrintJournalCommand}"
                                        Style="{StaticResource ReportActionButtonStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding JournalEntries}" CanUserSortColumns="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StartsGroup}" Value="True">
                                            <Setter Property="BorderThickness" Value="0,2,0,0" />
                                            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="HORA" Binding="{Binding TimeText}" Width="0.9*" />
                                <DataGridTextColumn Header="CONCEPTO" Binding="{Binding Description}" Width="1.5*" />
                                <DataGridTextColumn Header="CUENTA" Binding="{Binding DisplayAccount}" Width="1.3*" />
                                <DataGridTextColumn Header="ABONADO" Binding="{Binding DebitText}" Width="1.0*" ElementStyle="{StaticResource CenteredReportCell}" HeaderStyle="{StaticResource AppCenteredTableHeader}" />
                                <DataGridTextColumn Header="ACREDITADO" Binding="{Binding CreditText}" Width="1.0*" ElementStyle="{StaticResource CenteredReportCell}" HeaderStyle="{StaticResource AppCenteredTableHeader}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="{Binding JournalActionMessage}" Margin="0,7,0,0" FontSize="9"
                                   Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding LedgerVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl Style="{StaticResource AccountingReportHeader}" Content="Libro Mayor" />
                <Grid Grid.Row="1" Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="125" /><ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding LedgerAccounts}" SelectedItem="{Binding SelectedLedgerAccount}"
                              Height="32" VerticalContentAlignment="Center" ToolTip="Selecciona la cuenta contable" />
                    <TextBlock Grid.Column="1" Text="Año" Margin="12,0,7,0" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding JournalYears}" SelectedItem="{Binding SelectedLedgerYear}"
                              AutomationProperties.Name="Año del Libro Mayor" />
                    <TextBlock Grid.Column="3" Text="Mes" Margin="12,0,7,0" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding JournalMonths}" DisplayMemberPath="Name" SelectedValuePath="Number"
                              SelectedValue="{Binding SelectedLedgerMonth}" AutomationProperties.Name="Mes del Libro Mayor" />
                    <Button Grid.Column="6" Content="Exportar PDF" Command="{Binding ExportLedgerCommand}" ToolTip="Exporta la cuenta seleccionada"
                            Style="{StaticResource ReportActionButtonStyle}" Margin="0,0,8,0" />
                    <Button Grid.Column="7" Content="Imprimir" Command="{Binding PrintLedgerCommand}" ToolTip="Imprime la cuenta seleccionada"
                            Style="{StaticResource ReportActionButtonStyle}" />
                </Grid>
                <TabControl Grid.Row="2">
                    <TabItem Header="Detalle de la cuenta">
                        <DockPanel Margin="0,8,0,0">
                            <Border DockPanel.Dock="Bottom" Style="{StaticResource ReportTotalsPanel}" Margin="0,8,0,0">
                                <UniformGrid Rows="1">
                                    <StackPanel><TextBlock Text="Abonado" /><TextBlock Text="{Binding SelectedLedgerTotals.DebitText}" FontWeight="SemiBold" /></StackPanel>
                                    <StackPanel><TextBlock Text="Acreditado" /><TextBlock Text="{Binding SelectedLedgerTotals.CreditText}" FontWeight="SemiBold" /></StackPanel>
                                    <StackPanel><TextBlock Text="Saldo final" /><TextBlock Text="{Binding SelectedLedgerTotals.ClosingText}" FontWeight="SemiBold" /></StackPanel>
                                </UniformGrid>
                            </Border>
                            <DataGrid ItemsSource="{Binding LedgerEntries}" ColumnHeaderStyle="{StaticResource AppCenteredTableHeader}"
                                      CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding DateText}" Width="0.9*" ElementStyle="{StaticResource CenteredReportCell}" />
                                    <DataGridTextColumn Header="DOCUMENTO" Binding="{Binding Reference}" Width="1.7*" />
                                    <DataGridTextColumn Header="CONCEPTO" Binding="{Binding Description}" Width="1.6*" ElementStyle="{StaticResource CenteredReportCell}" />
                                    <DataGridTextColumn Header="ABONADO" Binding="{Binding DebitText}" Width="1.0*" ElementStyle="{StaticResource CenteredReportCell}" />
                                    <DataGridTextColumn Header="ACREDITADO" Binding="{Binding CreditText}" Width="1.0*" ElementStyle="{StaticResource CenteredReportCell}" />
                                    <DataGridTextColumn Header="SALDO" Binding="{Binding BalanceText}" Width="1.0*" ElementStyle="{StaticResource CenteredReportCell}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Totales de todas las cuentas">
                        <DockPanel Margin="0,8,0,0">
                            <DataGrid ItemsSource="{Binding LedgerTotals}" RowStyle="{StaticResource StatementDataGridRowStyle}" CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CUENTA" Binding="{Binding Account}" Width="1.5*" />
                                    <DataGridTextColumn Header="SALDO INICIAL" Binding="{Binding OpeningText}" Width="*" ElementStyle="{StaticResource NumericCellTextStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                                    <DataGridTextColumn Header="ABONADO" Binding="{Binding DebitText}" Width="*" ElementStyle="{StaticResource NumericCellTextStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                                    <DataGridTextColumn Header="ACREDITADO" Binding="{Binding CreditText}" Width="*" ElementStyle="{StaticResource NumericCellTextStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                                    <DataGridTextColumn Header="SALDO FINAL" Binding="{Binding ClosingText}" Width="*" ElementStyle="{StaticResource NumericCellTextStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
                <TextBlock Grid.Row="3" Text="{Binding LedgerActionMessage}" Margin="0,7,0,0" FontSize="9"
                           Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
            </Grid>

            <Grid Visibility="{Binding KardexVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ContentControl Style="{StaticResource AccountingReportHeader}" Content="Hoja de Kardex" />
                <Grid Grid.Row="1" Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="112" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="112" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Producto" Style="{StaticResource ReportMetadataText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding KardexProducts}" SelectedItem="{Binding SelectedKardexProduct}"
                              DisplayMemberPath="Name" TextSearch.TextPath="Name" IsEditable="True"
                              AutomationProperties.Name="Buscar producto por nombre" Height="32" />
                    <TextBlock Grid.Column="2" Text="Desde" Style="{StaticResource ReportMetadataText}" VerticalAlignment="Center" Margin="12,0,7,0" />
                    <DatePicker Grid.Column="3" SelectedDate="{Binding KardexStartDate, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4" Text="Hasta" Style="{StaticResource ReportMetadataText}" VerticalAlignment="Center" Margin="12,0,7,0" />
                    <DatePicker Grid.Column="5" SelectedDate="{Binding KardexEndDate, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="6" Content="Exportar PDF" Command="{Binding ExportKardexCommand}"
                            Style="{StaticResource ReportActionButtonStyle}" Margin="12,0,8,0" />
                    <Button Grid.Column="7" Content="Imprimir" Command="{Binding PrintKardexCommand}" Style="{StaticResource ReportActionButtonStyle}" />
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding KardexMovements}" ColumnHeaderHeight="54"
                          CanUserSortColumns="False" CanUserReorderColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding DateText}" Width="100" />
                        <DataGridTextColumn Header="Movimiento" Binding="{Binding Description}" Width="112" />
                        <DataGridTemplateColumn Header="Entrada" Width="252" HeaderStyle="{StaticResource KardexGroupColumnHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <UniformGrid Rows="1">
                                        <TextBlock Text="{Binding EntryQuantity}" Style="{StaticResource CenteredReportCell}" />
                                        <TextBlock Text="{Binding EntryUnitCost}" Style="{StaticResource CenteredReportCell}" />
                                        <TextBlock Text="{Binding EntryTotal}" Style="{StaticResource CenteredReportCell}" />
                                    </UniformGrid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Salida" Width="252" HeaderStyle="{StaticResource KardexGroupColumnHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <UniformGrid Rows="1">
                                        <TextBlock Text="{Binding ExitQuantity}" Style="{StaticResource CenteredReportCell}" />
                                        <TextBlock Text="{Binding ExitUnitCost}" Style="{StaticResource CenteredReportCell}" />
                                        <TextBlock Text="{Binding ExitTotal}" Style="{StaticResource CenteredReportCell}" />
                                    </UniformGrid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Totales" Width="252" HeaderStyle="{StaticResource KardexGroupColumnHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <UniformGrid Rows="1">
                                        <TextBlock Text="{Binding BalanceQuantity}" Style="{StaticResource CenteredReportCell}" />
                                        <TextBlock Text="{Binding BalanceUnitCost}" Style="{StaticResource CenteredReportCell}" />
                                        <TextBlock Text="{Binding BalanceTotal}" Style="{StaticResource CenteredReportCell}" />
                                    </UniformGrid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="3" Style="{StaticResource ReportTotalsPanel}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Existencias por lote al corte" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <DataGrid ItemsSource="{Binding KardexRemainingStock}" MaxHeight="135" RowHeight="26"
                                  CanUserSortColumns="False" ColumnHeaderStyle="{StaticResource AppCenteredTableHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Lote" Binding="{Binding Folio}" Width="*" ElementStyle="{StaticResource CenteredReportCell}" />
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="*" ElementStyle="{StaticResource CenteredReportCell}" />
                                <DataGridTextColumn Header="Valor unitario" Binding="{Binding UnitValueText}" Width="*" ElementStyle="{StaticResource CenteredReportCell}" />
                                <DataGridTextColumn Header="Valor total" Binding="{Binding TotalValueText}" Width="*" ElementStyle="{StaticResource CenteredReportCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock FontWeight="SemiBold" Margin="0,5,0,0"><Run Text="{Binding KardexClosingStock, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding KardexClosingValue, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="4" Text="{Binding KardexActionMessage}" Margin="0,7,0,0" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
            </Grid>

            <ScrollViewer Visibility="{Binding FinancialPositionVisibility}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,8">
                <StackPanel Margin="0,0,0,8">
                    <ContentControl Style="{StaticResource AccountingReportHeader}" Content="Estado de Situación Financiera" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Exportar PDF" Command="{Binding ExportFinancialPositionCommand}"
                                    Style="{StaticResource ReportActionButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="Imprimir" Command="{Binding PrintFinancialPositionCommand}"
                                    Style="{StaticResource ReportActionButtonStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mes de corte" Style="{StaticResource ReportMetadataText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding ReportMonthOptions}" SelectedItem="{Binding FinancialPositionCutoffMonth}"
                                  ItemStringFormat="MMMM yyyy" Language="es-HN" AutomationProperties.Name="Mes de corte"
                                  Width="155" Height="28" Margin="0,0,12,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
                <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}" BorderBrush="{StaticResource RocaMayaBorderBrush}"
                        BorderThickness="0,1" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding FinancialPositionMetrics}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,8" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,1,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Value}" Margin="0,4,0,0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <DataGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" MinRowHeight="30" RowHeight="NaN" ItemsSource="{Binding FinancialPositionLines}" RowStyle="{StaticResource StatementDataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="GRUPO" Binding="{Binding Group}" Width="1.2*" />
                        <DataGridTextColumn Header="CUENTA" Binding="{Binding Account}" Width="2.0*" />
                        <DataGridTextColumn Header="SALDO" Binding="{Binding Amount}" Width="1.0*" ElementStyle="{StaticResource NumericCellTextStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Margin="0,14,0,4">
                    <TextBlock Text="Comparativa de activos, patrimonio y pasivos" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Rectangle Width="10" Height="10" Fill="{StaticResource RocaMayaChartBlueBrush}" Margin="0,0,5,0" /><TextBlock Text="Activos" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Rectangle Width="10" Height="10" Fill="{StaticResource RocaMayaChartMintBrush}" Margin="0,0,5,0" /><TextBlock Text="Patrimonio" /></StackPanel>
                        <StackPanel Orientation="Horizontal"><Rectangle Width="10" Height="10" Fill="{StaticResource RocaMayaChartCoralBrush}" Margin="0,0,5,0" /><TextBlock Text="Pasivos" /></StackPanel>
                    </WrapPanel>
                    <TextBlock Text="Monto (L)" Style="{StaticResource ReportChartAxisText}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Margin="0,20,0,1" BorderThickness="0,0,1,0" BorderBrush="{StaticResource RocaMayaTextSecondaryBrush}">
                                <Grid Height="150" MinWidth="78" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding FinancialPositionScaleTop}" VerticalAlignment="Top" HorizontalAlignment="Right" Style="{StaticResource ReportChartAxisText}" />
                                    <TextBlock Text="{Binding FinancialPositionScaleMiddle}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource ReportChartAxisText}" />
                                    <TextBlock Text="L 0.00" VerticalAlignment="Bottom" HorizontalAlignment="Right" Style="{StaticResource ReportChartAxisText}" />
                                </Grid>
                            </Border>
                            <Grid Height="{Binding FinancialPositionNegativeHeight}">
                                <TextBlock Text="{Binding FinancialPositionScaleBottom}" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="11" Margin="0,0,8,0" />
                            </Grid>
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding FinancialPositionBars}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Amount}" Height="20" Style="{StaticResource ReportChartValueText}" />
                                        <Grid Height="150" Background="{StaticResource RocaMayaBlueSurfaceBrush}">
                                            <Border Style="{StaticResource ReportChartGuide}" VerticalAlignment="Top" Height="1" />
                                            <Border Style="{StaticResource ReportChartGuide}" VerticalAlignment="Center" Height="1" />
                                            <Rectangle Width="48" Height="{Binding PositiveHeight}" VerticalAlignment="Bottom" Style="{StaticResource FinancialPositionBarStyle}" />
                                        </Grid>
                                        <Border Style="{StaticResource ReportChartBaseline}" />
                                        <Grid Height="{Binding DataContext.FinancialPositionNegativeHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Rectangle Width="48" Height="{Binding NegativeHeight}" VerticalAlignment="Top" Style="{StaticResource FinancialPositionBarStyle}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <Border Style="{StaticResource ReportTotalsPanel}" Margin="0,12,0,0"
                            BorderBrush="{Binding FinancialPositionFinancing.RecommendationColor}" BorderThickness="3,1,1,1">
                        <StackPanel>
                        <TextBlock Text="Consejo de financiamiento" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource RocaMayaChartTextBrush}" />
                            <TextBlock Text="{Binding FinancialPositionFinancing.Recommendation}" TextWrapping="Wrap" FontSize="15"
                                       Foreground="{StaticResource RocaMayaChartTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding StatementActionMessage}" Margin="0,6,0,0" FontSize="9" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Visibility="{Binding IncomeStatementVisibility}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,8">
                    <ContentControl Style="{StaticResource AccountingReportHeader}" Content="Estado de Resultados" />
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Exportar PDF" Command="{Binding ExportIncomeStatementCommand}" Style="{StaticResource ReportActionButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="Imprimir" Command="{Binding PrintIncomeStatementCommand}" Style="{StaticResource ReportActionButtonStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Desde" Style="{StaticResource ReportMetadataText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding ReportMonthOptions}" SelectedItem="{Binding IncomeStartDate}" ItemStringFormat="MMMM yyyy"
                                  Language="es-HN" AutomationProperties.Name="Mes inicial" Width="155" Height="28" Margin="0,0,12,0" />
                        <TextBlock Text="Hasta" Style="{StaticResource ReportMetadataText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding ReportMonthOptions}" SelectedItem="{Binding IncomeEndDate}" ItemStringFormat="MMMM yyyy"
                                  Language="es-HN" AutomationProperties.Name="Mes final" Width="155" Height="28" Margin="0,0,12,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding IncomeStatementLines}" ScrollViewer.VerticalScrollBarVisibility="Disabled" MinRowHeight="30" RowHeight="NaN" RowStyle="{StaticResource StatementDataGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Group}" Width="1.7*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Descripción" Binding="{Binding Account}" Width="2.2*" />
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Amount}" Width="1.0*" ElementStyle="{StaticResource NumericCellTextStyle}" HeaderStyle="{StaticResource AppRightTableHeader}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <TextBlock Text="{Binding StatementActionMessage}" Margin="0,6,0,0" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ReportMetadataText}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Evolución mensual" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Monto (L)" Style="{StaticResource ReportChartAxisText}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding IncomeChartStatusMessage}" Margin="0,3,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ReportMetadataText}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel Margin="0,4,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="10" Height="10" Fill="{StaticResource RocaMayaChartBlueBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="Ventas" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="10" Height="10" Fill="{StaticResource RocaMayaChartPeachBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="Costos y gastos" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="10" Height="10" Fill="{StaticResource RocaMayaChartMintBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="Utilidad neta" />
                            </StackPanel>
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Top">
                                <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource RocaMayaTextSecondaryBrush}">
                                    <Grid Height="100" Margin="0,0,8,0" MinWidth="58">
                                        <TextBlock Text="{Binding IncomeChartMaximumText}" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="11" />
                                        <TextBlock Text="{Binding IncomeChartMidpointText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" />
                                        <TextBlock Text="L 0.00" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="11" />
                                    </Grid>
                                </Border>
                                <Grid Height="{Binding IncomeChartNegativeHeight}">
                                    <TextBlock Text="{Binding IncomeChartMinimumText}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="11" />
                                </Grid>
                            </StackPanel>
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding IncomeChartMonths}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="132">
                                                <Grid Height="100" Background="{StaticResource RocaMayaBlueSurfaceBrush}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <Border Grid.ColumnSpan="3" Style="{StaticResource ReportChartGuide}" VerticalAlignment="Top" Height="1" />
                                                    <Border Grid.ColumnSpan="3" Style="{StaticResource ReportChartGuide}" VerticalAlignment="Center" Height="1" />
                                                    <Rectangle Grid.Column="0" Width="24" Height="{Binding Sales.AboveZero}" VerticalAlignment="Bottom" Margin="2,0" Fill="{StaticResource RocaMayaChartBlueBrush}"
                                                               ToolTip="{Binding Sales.Amount}" />
                                                    <Rectangle Grid.Column="1" Width="24" Height="{Binding Costs.AboveZero}" VerticalAlignment="Bottom" Margin="2,0" Fill="{StaticResource RocaMayaChartPeachBrush}"
                                                               ToolTip="{Binding Costs.Amount}" />
                                                    <Rectangle Grid.Column="2" Width="24" Height="{Binding NetIncome.AboveZero}" VerticalAlignment="Bottom" Margin="2,0" Fill="{StaticResource RocaMayaChartMintBrush}"
                                                               ToolTip="{Binding NetIncome.Amount}" />
                                                </Grid>
                                                <Border Style="{StaticResource ReportChartBaseline}" />
                                                <Grid Height="{Binding DataContext.IncomeChartNegativeHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" Background="{StaticResource RocaMayaBlueSurfaceBrush}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Column="0" Width="24" Height="{Binding Sales.BelowZero}" VerticalAlignment="Top" Margin="2,0" Fill="{StaticResource RocaMayaChartBlueBrush}"
                                                               ToolTip="{Binding Sales.Amount}" />
                                                    <Rectangle Grid.Column="1" Width="24" Height="{Binding Costs.BelowZero}" VerticalAlignment="Top" Margin="2,0" Fill="{StaticResource RocaMayaChartPeachBrush}"
                                                               ToolTip="{Binding Costs.Amount}" />
                                                    <Rectangle Grid.Column="2" Width="24" Height="{Binding NetIncome.BelowZero}" VerticalAlignment="Top" Margin="2,0" Fill="{StaticResource RocaMayaChartMintBrush}"
                                                               ToolTip="{Binding NetIncome.Amount}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,5,0,3" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Sales.Amount}" Style="{StaticResource ReportChartValueText}" Foreground="{StaticResource RocaMayaChartTextBrush}" />
                                                <TextBlock Text="{Binding Costs.Amount}" Style="{StaticResource ReportChartValueText}" Foreground="{StaticResource RocaMayaChartTextBrush}" />
                                                <TextBlock Text="{Binding NetIncome.Amount}" Style="{StaticResource ReportChartValueText}" Foreground="{StaticResource RocaMayaChartTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <StackPanel Margin="0,12,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IncomePeriodChanges.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Variación del primer al último mes" FontWeight="SemiBold" Margin="0,0,0,5" />
                            <ItemsControl ItemsSource="{Binding IncomePeriodChanges}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ReportTotalsPanel}" Margin="0,0,5,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorable}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource RocaMayaSuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFavorable}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource RocaMayaDangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
