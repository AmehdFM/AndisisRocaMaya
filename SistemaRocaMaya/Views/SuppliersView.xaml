<UserControl x:Class="SistemaRocaMaya.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid Background="{StaticResource RocaMayaSurfaceBrush}" Margin="30,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Proveedores" FontSize="26" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="＋  Nuevo proveedor" Click="CreateSupplier_Click"
                    Height="40" Padding="14,0" Background="{StaticResource RocaMayaBlackPrimaryBrush}" BorderThickness="0"
                    Foreground="White" FontWeight="SemiBold" Cursor="Hand" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,18,0">
                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="10,0"
                         VerticalContentAlignment="Center" Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                         ToolTip="Buscar proveedor por nombre, teléfono o contacto" />
                <Border Grid.Row="1" Margin="0,10,0,0" Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1,0,0">
                <ListBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" Background="White" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="White" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource RocaMayaBlueSelectedBrush}" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,12" BorderBrush="{StaticResource RocaMayaDividerBrush}" BorderThickness="0,0,0,1"
                                        Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                        <TextBlock Text="{Binding Phone}" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}" BorderBrush="{StaticResource RocaMayaBorderBrush}"
                        BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedSupplier.Name, TargetNullValue='Selecciona un proveedor'}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                            <TextBlock Text="{Binding SelectedSupplier.Contact, StringFormat='Contacto: {0}'}" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedSupplier.Phone, StringFormat='Teléfono: {0}'}" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedSupplier.Purchases.Count, StringFormat='Compras: {0}'}"
                                   VerticalAlignment="Center" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" FontSize="11" />
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="Historial de compras" Margin="0,16,0,8" FontSize="14"
                           FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                <TextBox Grid.Row="2" Text="{Binding PurchaseSearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="34" Padding="10,0" Margin="0,0,0,8" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                         ToolTip="Filtrar por número o fecha" />
                <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,1,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedSupplierPurchases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,12" BorderBrush="{StaticResource RocaMayaDividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                                <TextBlock Text="{Binding DateText}" Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Lines.Count, StringFormat='{}{0} productos'}" Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" VerticalAlignment="Center"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
