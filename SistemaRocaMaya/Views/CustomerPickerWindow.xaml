<Window x:Class="SistemaRocaMaya.Views.CustomerPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clientes · Roca Maya" Width="480" Height="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource RocaMayaSurfaceBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource AppButton}" />
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
            <DockPanel>
                <Image DockPanel.Dock="Right" Source="{StaticResource ReportWordmark}" Width="86" Height="36" Stretch="Uniform" Margin="12,0,0,0" AutomationProperties.Name="Consul Farma Roca Maya" />
                <TextBlock Text="Clientes" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" FontSize="17" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,18">
            <Grid x:Name="BrowsePanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" Grid.Row="0" Height="34" Padding="10,0" FontSize="12"
                         VerticalContentAlignment="Center" Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                         TextChanged="SearchBox_TextChanged" />
                <ListBox x:Name="CustomersList" Grid.Row="1" Margin="0,10,0,0" BorderThickness="0"
                         Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Phone}" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" FontSize="11"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StackPanel x:Name="CreatePanel" Visibility="Collapsed">
                <TextBlock Text="Nuevo cliente" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}"
                           Margin="0,0,0,16" />
                <TextBlock Text="Nombre" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" />
                <TextBlock Text="Teléfono" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,12,0,4" />
                <TextBox x:Name="PhoneBox" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" />
                <TextBlock Text="Tipo de cliente" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,12,0,4" />
                <ComboBox x:Name="TypeBox" Height="28" MinHeight="28" Padding="6,0" VerticalContentAlignment="Center" SelectedIndex="0"
                          SelectionChanged="TypeBox_SelectionChanged" Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}">
                    <ComboBoxItem Content="Persona" Tag="Person" />
                    <ComboBoxItem Content="Empresa" Tag="Company" />
                </ComboBox>
                <TextBlock x:Name="IdentificationLabel" Text="Identidad" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}"
                           Margin="0,12,0,4" />
                <TextBox x:Name="IdentificationBox" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" />
                <TextBlock x:Name="ValidationText" Text="Escribe el nombre y el teléfono del cliente."
                           Foreground="{StaticResource RocaMayaDangerBrush}" FontSize="11" Margin="0,10,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource RocaMayaBlueSurfaceBrush}" Padding="20,12">
            <Grid>
                <StackPanel x:Name="BrowseActions" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource AppButton}" Content="Cancelar" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                    <Button Style="{StaticResource AppButton}" Content="Crear cliente" Margin="0,0,8,0" Click="ShowCreate_Click" />
                    <Button Style="{StaticResource AppPrimaryButton}" Content="Seleccionar" Click="Select_Click" />
                </StackPanel>
                <StackPanel x:Name="CreateActions" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="Collapsed">
                    <Button Style="{StaticResource AppButton}" Content="Volver" Margin="0,0,8,0" Click="Back_Click" />
                    <Button Style="{StaticResource AppButton}" Content="Cancelar" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                    <Button Style="{StaticResource AppPrimaryButton}" Content="Crear y seleccionar" Click="Create_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
