<Window x:Class="SistemaRocaMaya.Views.CustomerPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clientes · Roca Maya" Width="480" Height="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource RocaMayaCreamBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E3EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource RocaMayaCreamBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource RocaMayaBlueSecondaryBrush}" Padding="20,0">
            <TextBlock Text="Clientes" Foreground="White" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Border>

        <Grid Grid.Row="1" Margin="20,18">
            <Grid x:Name="BrowsePanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Busca por nombre o teléfono y selecciona el cliente de esta venta."
                           Foreground="#526A7A" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBox x:Name="SearchBox" Grid.Row="1" Height="36" Padding="10,0" FontSize="12"
                         VerticalContentAlignment="Center" Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}"
                         TextChanged="SearchBox_TextChanged" />
                <ListBox x:Name="CustomersList" Grid.Row="2" Margin="0,10,0,0" BorderThickness="0"
                         Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Phone}" Foreground="#526A7A" FontSize="11"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StackPanel x:Name="CreatePanel" Visibility="Collapsed">
                <TextBlock Text="Nuevo cliente" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}"
                           Margin="0,0,0,16" />
                <TextBlock Text="Nombre" FontSize="11" Foreground="#526A7A" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" />
                <TextBlock Text="Teléfono" FontSize="11" Foreground="#526A7A" Margin="0,12,0,4" />
                <TextBox x:Name="PhoneBox" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" />
                <TextBlock Text="Tipo de cliente" FontSize="11" Foreground="#526A7A" Margin="0,12,0,4" />
                <ComboBox x:Name="TypeBox" Height="36" Padding="8,0" SelectedIndex="0"
                          SelectionChanged="TypeBox_SelectionChanged" Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}">
                    <ComboBoxItem Content="Persona" Tag="Person" />
                    <ComboBoxItem Content="Empresa" Tag="Company" />
                </ComboBox>
                <TextBlock x:Name="IdentificationLabel" Text="Identidad" FontSize="11" Foreground="#526A7A"
                           Margin="0,12,0,4" />
                <TextBox x:Name="IdentificationBox" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" />
                <TextBlock x:Name="ValidationText" Text="Escribe el nombre y el teléfono del cliente."
                           Foreground="#9B2C2C" FontSize="11" Margin="0,10,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource RocaMayaCreamBrush}" Padding="20,12">
            <Grid>
                <StackPanel x:Name="BrowseActions" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Crear cliente" Margin="0,0,8,0" Click="ShowCreate_Click"
                            Background="White" BorderBrush="{StaticResource RocaMayaBlueSecondaryBrush}" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                    <Button Content="Seleccionar" Margin="0,0,8,0" Click="Select_Click"
                            Background="{StaticResource RocaMayaBlackPrimaryBrush}" BorderThickness="0"
                            Foreground="White" />
                    <Button Content="Cancelar" IsCancel="True" Click="Cancel_Click"
                            Background="Transparent" BorderBrush="#C8DCE8" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                </StackPanel>
                <StackPanel x:Name="CreateActions" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="Collapsed">
                    <Button Content="Volver" Margin="0,0,8,0" Click="Back_Click"
                            Background="White" BorderBrush="{StaticResource RocaMayaBlueSecondaryBrush}" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                    <Button Content="Crear y seleccionar" Margin="0,0,8,0" Click="Create_Click"
                            Background="{StaticResource RocaMayaBlackPrimaryBrush}" BorderThickness="0"
                            Foreground="White" />
                    <Button Content="Cancelar" IsCancel="True" Click="Cancel_Click"
                            Background="Transparent" BorderBrush="#C8DCE8" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
