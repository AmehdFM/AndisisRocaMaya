<UserControl x:Class="SistemaRocaMaya.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="ProductAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A6F9E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="48" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="CheckoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F7A45" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="56" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Caja" FontSize="24" FontWeight="Bold" Foreground="#20394B" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding CashStatusText}" FontSize="10" Foreground="#526A7A"
                           HorizontalAlignment="Right" Margin="0,0,0,4" />
                <Button Content="{Binding CashActionLabel}" Click="ToggleCashSession_Click"
                        MinWidth="112" Height="32" Padding="12,0" HorizontalAlignment="Right"
                        Background="#080818" BorderThickness="0" Foreground="White"
                        FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>
            <Button Grid.Column="2" MinWidth="150" Height="40" Padding="14,0"
                    Background="#E8F1F6" BorderBrush="#C8DCE8" BorderThickness="1"
                    Foreground="#3888C0" FontSize="12" FontWeight="SemiBold"
                    Command="{Binding DataContext.ToggleFocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="{Binding DataContext.FocusButtonLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                    />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="24,0,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="ProductSearchBox" Height="44" Padding="14,0" VerticalContentAlignment="Center"
                                 FontSize="14" Background="White" BorderBrush="#D5E0E7" BorderThickness="1" />
                        <TextBlock Text="Buscar por código o nombre de producto" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Foreground="#8797A3" FontSize="13"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ProductSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                               Text="Escanear código" FontSize="12" Foreground="#718391" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="225" Height="112" Margin="0,0,10,8" Padding="8"
                                        Background="White" BorderBrush="#D8E3EA" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="#20394B" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PriceText}" Margin="0,3,0,0" FontSize="14"
                                                       FontWeight="Bold" Foreground="#1F7A45" />
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="4,0"
                                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                     Background="White" BorderBrush="#C8DCE8" BorderThickness="1" />
                                            <Button Grid.Column="1" Margin="6,0,0,0" Height="32" Style="{StaticResource ProductAddButtonStyle}" Content="Agregar"
                                                Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="1" Background="White" BorderBrush="#DCE4E9" BorderThickness="1,0,0,0">
                <Grid Margin="20,18,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Venta actual" FontSize="17" FontWeight="Bold" Foreground="#20394B" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Vaciar" Height="48" MinWidth="72" Command="{Binding ClearCartCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="#2A6F9E"
                                FontSize="12" FontWeight="SemiBold" Cursor="Hand" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#314B5E" />
                                            <TextBlock Text="{Binding QuantityAndPriceText}" Margin="0,3,0,0" FontSize="11" Foreground="#718391" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LineTotalText}" Foreground="#1F7A45" FontSize="12"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button Content="×" Margin="6,0,0,0" Width="48" Height="48"
                                                    Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                                                    Foreground="#718391" FontSize="17" Cursor="Hand" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Border Height="1" Background="#E4EAEE" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Subtotal" Foreground="#718391" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" Foreground="#314B5E" FontSize="12" />
                        </Grid>
                        <Grid Margin="0,9,0,15">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Total" Foreground="#20394B" FontSize="16" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" Foreground="#1F7A45" FontSize="22" FontWeight="Bold" />
                        </Grid>
                        <TextBlock Text="Método de pago" Margin="0,10,0,4" FontSize="11" FontWeight="SemiBold" Foreground="#526A7A" />
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}"
                                  Height="30" Padding="7,0" FontSize="12" VerticalContentAlignment="Center"
                                  Background="White" BorderBrush="#C8DCE8" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding CreditDetailsVisibility}">
                            <TextBlock Text="Cliente" Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="#526A7A" />
                            <Button Height="30" Padding="8,0" HorizontalContentAlignment="Stretch"
                                    Background="White" BorderBrush="#58B8E8" Foreground="#080818"
                                    Click="ChooseCustomer_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedCustomer.DisplayText, TargetNullValue='Seleccionar cliente'}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="Elegir  ▾" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="#3888C0" FontSize="11" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource CheckoutButtonStyle}" Content="Cobrar" Margin="0,12,0,0"
                                IsEnabled="{Binding IsCashOpen}"
                                Click="Checkout_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#E9EFF3">
            <DockPanel Margin="24,0" LastChildFill="False">
                <TextBlock Text="Prototipo · Los productos y el carrito son datos de demostración" VerticalAlignment="Center"
                           FontSize="10" Foreground="#637887" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
