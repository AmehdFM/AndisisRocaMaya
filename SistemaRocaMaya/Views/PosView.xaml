<UserControl x:Class="SistemaRocaMaya.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="ProductAddButtonStyle" TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}" />
        <Style x:Key="CheckoutButtonStyle" TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
            <Setter Property="MinHeight" Value="40" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="CashScreenContent" Background="{StaticResource RocaMayaSurfaceBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Effect">
                    <Setter.Value><BlurEffect Radius="0" /></Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCashOpen}" Value="False">
                        <Setter Property="Effect">
                            <Setter.Value><BlurEffect Radius="8" /></Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,8,16,8" Background="{StaticResource RocaMayaBlueSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Caja" Style="{StaticResource ReportHeadingText}" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding CashStatusText}" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}"
                           HorizontalAlignment="Right" Margin="0,0,0,4" />
                <Button Style="{StaticResource AppButton}" Content="{Binding CashActionLabel}" Click="ToggleCashSession_Click"
                        MinWidth="112" HorizontalAlignment="Right" />
            </StackPanel>
            <Button Style="{StaticResource AppButton}" Grid.Column="2" MinWidth="150"
                    Command="{Binding DataContext.ToggleFocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="{Binding DataContext.FocusButtonLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Image Grid.Column="3" Source="{StaticResource ReportWordmark}" Style="{StaticResource ReportWordmarkImage}" Margin="12,0" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="16,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="ProductSearchBox" Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                 FontSize="14" Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="1" />
                        <TextBlock Text="Buscar por código o nombre de producto" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" FontSize="13"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ProductSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                               Text="Escanear código" FontSize="12" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="225" Height="112" Margin="0,0,10,8" Padding="8"
                                        Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PriceText}" Margin="0,3,0,0" FontSize="14"
                                                       FontWeight="Bold" Foreground="{StaticResource RocaMayaSuccessBrush}" />
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="4,0"
                                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                     Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="1" />
                                            <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource ProductAddButtonStyle}" Content="Agregar"
                                                Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource AppDangerButton}" Content="Vaciar" MinWidth="68" Margin="0,0,12,0" Command="{Binding ClearCartCommand}" />
                        <TextBlock Grid.Column="1" Text="Venta actual" VerticalAlignment="Center" FontSize="17"
                                   FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                                            <TextBlock Text="{Binding QuantityAndPriceText}" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Background="{StaticResource RocaMayaDangerSoftBrush}" Foreground="{StaticResource RocaMayaDangerBrush}" BorderBrush="{StaticResource RocaMayaDangerBrush}" Style="{StaticResource AppIconButton}" Content="×" Margin="0,0,8,0" Width="32" Height="32"
                                                    Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    FontSize="17" />
                                            <TextBlock Text="{Binding LineTotalText}" Foreground="{StaticResource RocaMayaSuccessBrush}" FontSize="12"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Border Height="1" Background="{StaticResource RocaMayaDividerBrush}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Subtotal" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" FontSize="12" />
                        </Grid>
                        <Grid Margin="0,9,0,15">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Total" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" Foreground="{StaticResource RocaMayaSuccessBrush}" FontSize="22" FontWeight="Bold" />
                        </Grid>
                        <TextBlock Text="Método de pago" Margin="0,10,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}"
                                  Height="28" MinHeight="28" Padding="6,0" FontSize="12" VerticalContentAlignment="Center"
                                  Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding CreditDetailsVisibility}">
                            <TextBlock Text="Cliente" Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                            <Button Style="{StaticResource AppButton}" HorizontalContentAlignment="Stretch"
                                    Click="ChooseCustomer_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedCustomer.DisplayText, TargetNullValue='Seleccionar cliente'}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="Elegir  ▾" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" FontSize="11" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource CheckoutButtonStyle}" Content="Cobrar" Margin="0,12,0,0"
                                IsEnabled="{Binding IsCashOpen}"
                                Click="Checkout_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource RocaMayaBlueSurfaceBrush}">
            <DockPanel Margin="24,0" LastChildFill="False">
                <TextBlock Text="Prototipo · Los productos y el carrito son datos de demostración" VerticalAlignment="Center"
                           FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
            </DockPanel>
        </Border>
        </Grid>

        <Grid Panel.ZIndex="10" Background="{StaticResource RocaMayaOverlayBrush}" Visibility="{Binding CashClosedOverlayVisibility}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Caja cerrada" Margin="0,0,0,14" HorizontalAlignment="Center"
                           FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                <Button Style="{StaticResource AppButton}" Content="Abrir caja" Click="ToggleCashSession_Click" Width="230" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
