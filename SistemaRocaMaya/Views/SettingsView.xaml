<UserControl x:Class="SistemaRocaMaya.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid Background="{StaticResource RocaMayaSurfaceBrush}" Margin="{StaticResource AppPageMargin}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ContentControl Style="{StaticResource AppPageHeader}" Content="Configuración" />
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource RocaMayaBorderBrush}">
            <TabItem Header="Usuarios">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="El login reconoce dos cuentas de demostración: Administrador y Empleado."
                               Margin="0,0,0,12" FontSize="11" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" TextWrapping="Wrap" />
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Código de autorización del supervisor" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                            <TextBlock Text="Se solicita al empleado para abrir caja o conceder crédito sin permiso directo."
                                       Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <PasswordBox x:Name="AuthorizationCodeBox" Grid.Column="1" MaxLength="4" Height="34"
                                     Padding="8,0" VerticalContentAlignment="Center" Background="White"
                                     BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" PreviewTextInput="AuthorizationCode_PreviewTextInput" />
                        <Button Style="{StaticResource AppPrimaryButton}" Grid.Column="2" Content="Guardar código" Click="SaveAuthorizationCode_Click"
                                Margin="8,0,0,0" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding AuthorizationCodeStatus}"
                                   Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Users}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                              Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="USUARIO" Binding="{Binding Nombre}" Width="2*" />
                            <DataGridTextColumn Header="ROL" Binding="{Binding Rol.Nombre}" Width="1.2*" />
                            <DataGridCheckBoxColumn HeaderStyle="{StaticResource AppCenteredTableHeader}" Header="ACTIVO" Binding="{Binding Activo}" Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Roles">
                <Grid Margin="14">
                    <DataGrid ItemsSource="{Binding Roles}" AutoGenerateColumns="False"
                              IsReadOnly="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                              Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ROL" Binding="{Binding Nombre}" Width="0.8*" IsReadOnly="True" />
                            <DataGridTextColumn Header="PANTALLAS" Binding="{Binding PermisosTexto}" Width="1.7*" IsReadOnly="True" />
                            <DataGridCheckBoxColumn HeaderStyle="{StaticResource AppCenteredTableHeader}" Header="ABRIR CAJA" Binding="{Binding PuedeAbrirCaja, UpdateSourceTrigger=PropertyChanged}" Width="0.9*" />
                            <DataGridCheckBoxColumn HeaderStyle="{StaticResource AppCenteredTableHeader}" Header="CONCEDER CRÉDITO" Binding="{Binding PuedeVenderCredito, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" />
                            <DataGridCheckBoxColumn HeaderStyle="{StaticResource AppCenteredTableHeader}" Header="CREAR PRODUCTOS" Binding="{Binding PuedeCrearProductos, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" />
                            <DataGridCheckBoxColumn HeaderStyle="{StaticResource AppCenteredTableHeader}" Header="CREAR CLIENTES" Binding="{Binding PuedeCrearClientes, UpdateSourceTrigger=PropertyChanged}" Width="1.0*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
