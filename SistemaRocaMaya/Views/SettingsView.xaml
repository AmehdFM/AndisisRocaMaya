<UserControl x:Class="SistemaRocaMaya.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid Background="#F3F6F8" Margin="30,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Configuración" FontSize="26" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
        </StackPanel>
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="#D8E3EA">
            <TabItem Header="Usuarios">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="El login reconoce dos cuentas de demostración: Administrador y Empleado."
                               Margin="0,0,0,12" FontSize="11" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" TextWrapping="Wrap" />
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Código de autorización del supervisor" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                            <TextBlock Text="Se solicita al empleado para abrir caja o conceder crédito sin permiso directo."
                                       Margin="0,3,0,0" FontSize="10" Foreground="#526A7A" TextWrapping="Wrap" />
                        </StackPanel>
                        <PasswordBox x:Name="AuthorizationCodeBox" Grid.Column="1" MaxLength="4" Height="34"
                                     Padding="8,0" VerticalContentAlignment="Center" Background="White"
                                     BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" PreviewTextInput="AuthorizationCode_PreviewTextInput" />
                        <Button Grid.Column="2" Content="Guardar código" Click="SaveAuthorizationCode_Click"
                                Height="34" Margin="8,0,0,0" Padding="12,0" Background="{StaticResource RocaMayaBlackPrimaryBrush}"
                                BorderThickness="0" Foreground="White" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding AuthorizationCodeStatus}"
                                   Margin="0,40,0,0" FontSize="10" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Users}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                              Background="White" BorderBrush="#D8E3EA" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="USUARIO" Binding="{Binding Nombre}" Width="2*" />
                            <DataGridTextColumn Header="ROL" Binding="{Binding Rol.Nombre}" Width="1.2*" />
                            <DataGridCheckBoxColumn Header="ACTIVO" Binding="{Binding Activo}" Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Roles">
                <Grid Margin="14">
                    <DataGrid ItemsSource="{Binding Roles}" AutoGenerateColumns="False"
                              IsReadOnly="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                              Background="White" BorderBrush="#D8E3EA" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ROL" Binding="{Binding Nombre}" Width="0.8*" IsReadOnly="True" />
                            <DataGridTextColumn Header="PANTALLAS" Binding="{Binding PermisosTexto}" Width="1.7*" IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="ABRIR CAJA" Binding="{Binding PuedeAbrirCaja, UpdateSourceTrigger=PropertyChanged}" Width="0.9*" />
                            <DataGridCheckBoxColumn Header="CONCEDER CRÉDITO" Binding="{Binding PuedeVenderCredito, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" />
                            <DataGridCheckBoxColumn Header="CREAR PRODUCTOS" Binding="{Binding PuedeCrearProductos, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" />
                            <DataGridCheckBoxColumn Header="CREAR CLIENTES" Binding="{Binding PuedeCrearClientes, UpdateSourceTrigger=PropertyChanged}" Width="1.0*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
