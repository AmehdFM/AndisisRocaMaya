<Window x:Class="SistemaRocaMaya.Views.CashCheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobro en efectivo · Roca Maya"
        Width="370" Height="570" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource RocaMayaSurfaceBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
            <DockPanel>
                <Image DockPanel.Dock="Right" Source="{StaticResource ReportWordmark}" Width="86" Height="36" Stretch="Uniform" Margin="12,0,0,0" AutomationProperties.Name="Consul Farma Roca Maya" />
                <TextBlock Text="Cobro en efectivo" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="1" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Total de la venta" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                    <TextBlock x:Name="TotalText" Grid.Column="1" VerticalAlignment="Center"
                               FontSize="18" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,9,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <TextBlock Text="Cantidad recibida" Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}" BorderThickness="1" Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="L" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                        <TextBox x:Name="AmountBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" FontSize="18" FontWeight="SemiBold"
                                 Foreground="{StaticResource RocaMayaBlackPrimaryBrush}"
                                 TextAlignment="Right" VerticalContentAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Margin="0,9,0,0" Background="{StaticResource RocaMayaBlueSurfaceBrush}"
                    BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="1" Padding="12,7">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DifferenceLabel" Text="Falta por cobrar" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" />
                    <TextBlock x:Name="DifferenceText" Grid.Column="1" VerticalAlignment="Center"
                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource RocaMayaBlueSecondaryBrush}" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button MinHeight="0" Style="{StaticResource AppButton}" Grid.Row="0" Grid.Column="0" Tag="7" Content="7" Click="Key_Click" Margin="3" />
                <Button MinHeight="0" Style="{StaticResource AppButton}" Grid.Row="0" Grid.Column="1" Tag="8" Content="8" Click="Key_Click" Margin="3" />
                <Button MinHeight="0" Style="{StaticResource AppButton}" Grid.Row="0" Grid.Column="2" Tag="9" Content="9" Click="Key_Click" Margin="3" />
                <Button MinHeight="0" Style="{StaticResource AppButton}" Grid.Row="0" Grid.Column="3" Tag="⌫" Content="⌫" Click="Key_Click" Margin="3" />

                <Button MinHeight="0" Style="{StaticResource AppButton}" Grid.Row="1" Grid.Column="0" Tag="4" Content="4" Click="Key_Click" Margin="3" />
                <Button MinHeight="0" Style="{StaticResource AppButton}" Grid.Row="1" Grid.Column="1" Tag="5" Content="5" Click="Key_Click" Margin="3" />
                <Button MinHeight="0" Style="{StaticResource AppButton}" Grid.Row="1" Grid.Column="2" Tag="6" Content="6" Click="Key_Click" Margin="3" />
                <Button MinHeight="0" Style="{StaticResource AppButton}" Grid.Row="1" Grid.Column="3" Tag="C" Content="C" Click="Key_Click" Margin="3" />

                <Button MinHeight="0" Style="{StaticResource AppButton}" Grid.Row="2" Grid.Column="0" Tag="1" Content="1" Click="Key_Click" Margin="3" />
                <Button MinHeight="0" Style="{StaticResource AppButton}" Grid.Row="2" Grid.Column="1" Tag="2" Content="2" Click="Key_Click" Margin="3" />
                <Button MinHeight="0" Style="{StaticResource AppButton}" Grid.Row="2" Grid.Column="2" Tag="3" Content="3" Click="Key_Click" Margin="3" />
                <Button MinHeight="0" Style="{StaticResource AppButton}" Grid.Row="2" Grid.Column="3" Tag="0" Content="0" Click="Key_Click" Margin="3" />

                <Button MinHeight="0" Style="{StaticResource AppButton}" Grid.Row="3" Grid.Column="0" Tag="." Content="." Click="Key_Click" Margin="3" />
                <Button Style="{StaticResource AppButton}" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Content="Exacto" Click="Exact_Click" Margin="3" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" Padding="18,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AppButton}" Content="Cancelar" Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource AppPrimaryButton}" x:Name="ConfirmButton" Content="Confirmar cobro" Click="Confirm_Click"
                        IsEnabled="False" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
