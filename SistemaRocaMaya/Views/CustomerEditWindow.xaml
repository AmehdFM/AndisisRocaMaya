<Window x:Class="SistemaRocaMaya.Views.CustomerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cliente · Roca Maya" Width="420" Height="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource RocaMayaSurfaceBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource AppButton}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBluePrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource RocaMayaBlueSurfaceBrush}" BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
            <DockPanel>
                <Image DockPanel.Dock="Right" Source="{StaticResource ReportWordmark}" Width="86" Height="36" Stretch="Uniform" Margin="12,0,0,0" AutomationProperties.Name="Consul Farma Roca Maya" />
                <TextBlock x:Name="TitleText" Text="Nuevo cliente" Foreground="{StaticResource RocaMayaBlackPrimaryBrush}" FontSize="17"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="22,18">
            <TextBlock Text="Nombre" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" />
            <TextBlock Text="Teléfono" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,12,0,4" />
            <TextBox x:Name="PhoneBox" />
            <TextBlock Text="Tipo de cliente" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}" Margin="0,12,0,4" />
            <ComboBox x:Name="TypeBox" Height="28" MinHeight="28" Padding="6,0" VerticalContentAlignment="Center" SelectedIndex="0"
                      SelectionChanged="TypeBox_SelectionChanged" Background="White" BorderBrush="{StaticResource RocaMayaBluePrimaryBrush}">
                <ComboBoxItem Content="Persona" Tag="Person" />
                <ComboBoxItem Content="Empresa" Tag="Company" />
            </ComboBox>
            <TextBlock x:Name="IdentificationLabel" Text="Identidad" FontSize="11" Foreground="{StaticResource RocaMayaTextSecondaryBrush}"
                       Margin="0,12,0,4" />
            <TextBox x:Name="IdentificationBox" />
            <TextBlock x:Name="ValidationText" Text="Completa los datos del cliente."
                       Foreground="{StaticResource RocaMayaDangerBrush}" FontSize="11" Margin="0,10,0,0" Visibility="Collapsed" />
        </StackPanel>
        <Border Grid.Row="2" Background="White" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AppButton}" x:Name="CancelButton" Content="Cancelar" IsCancel="True" Click="Cancel_Click"
                        Margin="0,0,8,0" />
                <Button Style="{StaticResource AppPrimaryButton}" x:Name="PrimaryButton" Content="Crear cliente" Click="Create_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
