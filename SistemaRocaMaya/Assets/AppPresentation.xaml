<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ColorPalette.xaml" />
        <ResourceDictionary Source="ReportPresentation.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Thickness x:Key="AppPageMargin">16,12</Thickness>
    <Thickness x:Key="AppSectionGap">0,0,0,8</Thickness>
    <Style x:Key="AppPageHeader" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Style="{StaticResource ReportHeadingSurface}">
                        <DockPanel>
                            <Image DockPanel.Dock="Right" Source="{StaticResource ReportWordmark}"
                                   Style="{StaticResource ReportWordmarkImage}" Margin="12,0,0,0" />
                            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource ReportHeadingText}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppButton" TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Interaction" Background="{StaticResource RocaMayaBluePrimaryBrush}"
                                    CornerRadius="3" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Interaction" Property="Opacity" Value="0.15" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Interaction" Property="Opacity" Value="0.3" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource AppButton}" />
    <Style x:Key="AppPrimaryButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="Background" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="AppDangerButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="Background" Value="{StaticResource RocaMayaDangerSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource RocaMayaDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaDangerBrush}" />
    </Style>
    <Style x:Key="AppIconButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style x:Key="AppTextBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}" />
    <Style TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Field" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Margin="7,0,2,0"
                                               Background="Transparent" BorderThickness="0" Padding="0"
                                               Foreground="{TemplateBinding Foreground}"
                                               VerticalContentAlignment="Center" />
                            <Button x:Name="PART_Button" Grid.Column="1" Style="{x:Null}"
                                    Focusable="False" Cursor="Hand" AutomationProperties.Name="Abrir calendario"
                                    Foreground="{StaticResource RocaMayaBlueSecondaryBrush}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CalendarButton" Background="Transparent"
                                                BorderBrush="{StaticResource RocaMayaBorderBrush}" BorderThickness="1,0,0,0"
                                                CornerRadius="0,3,3,0">
                                            <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.2"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  Data="M 1,3 L 13,3 13,13 1,13 Z M 1,6 L 13,6 M 4,1 L 4,4 M 10,1 L 10,4" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CalendarButton" Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CalendarButton" Property="Background" Value="{StaticResource RocaMayaBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=PART_Root}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource RocaMayaBluePrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource RocaMayaTextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
                            <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TabSurface" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AppTableHeader" TargetType="DataGridColumnHeader">
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="AppRightTableHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppTableHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style x:Key="AppCenteredTableHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppTableHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppTableHeader}" />
    <Style TargetType="DataGrid">
        <Setter Property="MinRowHeight" Value="32" />
        <Setter Property="ColumnHeaderHeight" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource RocaMayaDividerBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="Background" Value="White" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
