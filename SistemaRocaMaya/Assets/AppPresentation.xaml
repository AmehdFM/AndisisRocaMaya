<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ColorPalette.xaml" />
        <ResourceDictionary Source="ReportPresentation.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Thickness x:Key="AppPageMargin">16,12</Thickness>
    <Thickness x:Key="AppSectionGap">0,0,0,8</Thickness>
    <Style x:Key="AppPageHeader" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Style="{StaticResource ReportHeadingSurface}">
                        <DockPanel>
                            <Image DockPanel.Dock="Right" Source="{StaticResource ReportWordmark}"
                                   Style="{StaticResource ReportWordmarkImage}" Margin="12,0,0,0" />
                            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource ReportHeadingText}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppButton" TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Interaction" Background="{StaticResource RocaMayaBluePrimaryBrush}"
                                    CornerRadius="3" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Interaction" Property="Opacity" Value="0.15" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Interaction" Property="Opacity" Value="0.3" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource AppButton}" />
    <Style x:Key="AppPrimaryButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="Background" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="AppDangerButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="Background" Value="{StaticResource RocaMayaDangerSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource RocaMayaDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaDangerBrush}" />
    </Style>
    <Style x:Key="AppIconButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style x:Key="AppTextBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}" />
    <Style TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource RocaMayaTextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource RocaMayaBlueSecondaryBrush}" />
                            <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TabSurface" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AppTableHeader" TargetType="DataGridColumnHeader">
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Background" Value="{StaticResource RocaMayaBlueSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource RocaMayaBlackPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppTableHeader}" />
    <Style TargetType="DataGrid">
        <Setter Property="MinRowHeight" Value="32" />
        <Setter Property="ColumnHeaderHeight" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderBrush" Value="{StaticResource RocaMayaBorderBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource RocaMayaDividerBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="Background" Value="White" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
